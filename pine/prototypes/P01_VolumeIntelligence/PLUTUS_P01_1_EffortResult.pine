//@version=6
indicator("PLUTUS P01.1 — Effort vs Result", shorttitle="PLUTUS P01.1", overlay=false, max_labels_count=100)

//==============================================================================
// PLUTUS P01.1 — Effort vs Result
// Purpose: classify the relationship between normalized participation (effort)
//          and normalized price movement (result) before footprint/order-flow
//          enhancement or higher-order confluence logic.
//==============================================================================

//------------------------------------------------------------------------------
// Inputs
//------------------------------------------------------------------------------
groupVolume = "Volume Normalization"
volBaselineMode = input.string("SMA", "Baseline Type", options=["SMA", "EMA"], group=groupVolume)
volBaselineLen  = input.int(20, "Baseline Length", minval=2, group=groupVolume)
volZLen         = input.int(50, "Z-Score Length", minval=5, group=groupVolume)

rvolLow       = input.float(0.70, "Low Effort RVOL <", minval=0.0, step=0.05, group=groupVolume)
rvolHigh      = input.float(1.20, "High Effort RVOL >=", minval=0.0, step=0.05, group=groupVolume)
rvolExtreme   = input.float(1.80, "Extreme Effort RVOL >=", minval=0.0, step=0.05, group=groupVolume)
volZAbnormal  = input.float(1.50, "Abnormal Volume Z >=", minval=0.0, step=0.10, group=groupVolume)

groupResult = "Price Result"
atrLen          = input.int(14, "ATR Length", minval=1, group=groupResult)
bodyHigh        = input.float(0.80, "High Body / ATR >=", minval=0.0, step=0.05, group=groupResult)
rangeHigh       = input.float(1.00, "High Range / ATR >=", minval=0.0, step=0.05, group=groupResult)
bodyLow         = input.float(0.35, "Low Body / ATR <=", minval=0.0, step=0.05, group=groupResult)
rangeLow        = input.float(0.65, "Low Range / ATR <=", minval=0.0, step=0.05, group=groupResult)
closeExtremePct = input.float(0.20, "Close Near Extreme %", minval=0.01, maxval=0.49, step=0.01, group=groupResult)

groupContext = "Context / Persistence"
persistenceBars = input.int(2, "Confirmation Bars", minval=1, maxval=5, group=groupContext)
useZConfirm     = input.bool(true, "Use Z-Score as High-Effort Confirmation", group=groupContext)

groupDisplay = "Display"
showTable       = input.bool(true, "Show Diagnostic Table", group=groupDisplay)
showStateMarks  = input.bool(false, "Show State Markers", group=groupDisplay)
showRvol        = input.bool(false, "Plot RVOL", group=groupDisplay)
showEfficiency  = input.bool(false, "Plot Price Efficiency", group=groupDisplay)

//------------------------------------------------------------------------------
// Volume / normalization
//------------------------------------------------------------------------------
volumeAvailable = not na(volume)
volumeType = syminfo.volumetype

float volBaseline = switch volBaselineMode
    "EMA" => ta.ema(volume, volBaselineLen)
    => ta.sma(volume, volBaselineLen)

float rvol = volumeAvailable and not na(volBaseline) and volBaseline != 0.0 ? volume / volBaseline : na
float volMean = ta.sma(volume, volZLen)
float volStdev = ta.stdev(volume, volZLen)
float volZ = volumeAvailable and not na(volMean) and not na(volStdev) and volStdev != 0.0 ? (volume - volMean) / volStdev : na

//------------------------------------------------------------------------------
// Price-result measurements
//------------------------------------------------------------------------------
float atr = ta.atr(atrLen)
float body = math.abs(close - open)
float tr = ta.tr(true)
float bodyAtr = not na(atr) and atr != 0.0 ? body / atr : na
float rangeAtr = not na(atr) and atr != 0.0 ? tr / atr : na
float displacementAtr = not na(atr) and atr != 0.0 ? math.abs(close - close[1]) / atr : na

float barRange = high - low
float closeLocation = barRange > 0.0 ? (close - low) / barRange : 0.5
bool closeNearHigh = closeLocation >= 1.0 - closeExtremePct
bool closeNearLow  = closeLocation <= closeExtremePct
bool bullishBar = close > open
bool bearishBar = close < open

// Price efficiency combines body, total range, and close-to-close displacement.
float priceEfficiency = na
if not na(bodyAtr) and not na(rangeAtr) and not na(displacementAtr)
    priceEfficiency := (bodyAtr + rangeAtr + displacementAtr) / 3.0

//------------------------------------------------------------------------------
// Effort classification
//------------------------------------------------------------------------------
bool abnormalZ = not na(volZ) and volZ >= volZAbnormal
bool highEffort = not na(rvol) and (rvol >= rvolHigh or (useZConfirm and abnormalZ))
bool extremeEffort = not na(rvol) and rvol >= rvolExtreme
bool lowEffort = not na(rvol) and rvol < rvolLow

//------------------------------------------------------------------------------
// Result classification
//------------------------------------------------------------------------------
bool highDirectionalResult = not na(bodyAtr) and not na(rangeAtr) and bodyAtr >= bodyHigh and rangeAtr >= rangeHigh
bool lowDirectionalResult  = not na(bodyAtr) and not na(rangeAtr) and bodyAtr <= bodyLow and rangeAtr <= rangeLow

bool directionalClose = (bullishBar and closeNearHigh) or (bearishBar and closeNearLow)
bool opposingClose = (bullishBar and closeNearLow) or (bearishBar and closeNearHigh)

//------------------------------------------------------------------------------
// Candidate states
//------------------------------------------------------------------------------
// Efficient expansion: strong effort, strong directional result, close near the
// directionally favorable extreme.
bool efficientExpansionCandidate = highEffort and highDirectionalResult and directionalClose

// Absorption: strong effort but poor directional progress, or strong effort with
// a close opposing the candle direction. Direction of absorption describes the
// expected beneficiary, not the aggressive side being absorbed.
bool bullishAbsorptionCandidate = highEffort and ((bearishBar and lowDirectionalResult) or (bearishBar and closeNearHigh))
bool bearishAbsorptionCandidate = highEffort and ((bullishBar and lowDirectionalResult) or (bullishBar and closeNearLow))

// Liquidity vacuum: large directional result despite relatively low effort.
bool liquidityVacuumCandidate = lowEffort and highDirectionalResult and directionalClose

// Compression: low effort and weak result.
bool compressionCandidate = lowEffort and lowDirectionalResult

//------------------------------------------------------------------------------
// Persistence helper
//------------------------------------------------------------------------------
// A state is confirmed only when every bar in the confirmation window satisfies
// the candidate condition. SMA of a 1/0 series equals 1 only when all N bars are true.
f_confirm(bool condition, int bars) =>
    float confirmationRatio = ta.sma(condition ? 1.0 : 0.0, bars)
    not na(confirmationRatio) and confirmationRatio >= 1.0

bool efficientExpansion = f_confirm(efficientExpansionCandidate, persistenceBars)
bool bullishAbsorption = f_confirm(bullishAbsorptionCandidate, persistenceBars)
bool bearishAbsorption = f_confirm(bearishAbsorptionCandidate, persistenceBars)
bool liquidityVacuum = f_confirm(liquidityVacuumCandidate, persistenceBars)
bool compression = f_confirm(compressionCandidate, persistenceBars)

//------------------------------------------------------------------------------
// Primary state precedence
//------------------------------------------------------------------------------
string state = "NEUTRAL"
if not volumeAvailable or na(rvol) or na(bodyAtr) or na(rangeAtr)
    state := "UNAVAILABLE"
else if bullishAbsorption
    state := "ABSORPTION_BULLISH"
else if bearishAbsorption
    state := "ABSORPTION_BEARISH"
else if efficientExpansion
    state := bullishBar ? "EXPANSION_BULLISH" : bearishBar ? "EXPANSION_BEARISH" : "EXPANSION"
else if liquidityVacuum
    state := bullishBar ? "VACUUM_BULLISH" : bearishBar ? "VACUUM_BEARISH" : "LIQUIDITY_VACUUM"
else if compression
    state := "COMPRESSION"

//------------------------------------------------------------------------------
// Diagnostics / plots
//------------------------------------------------------------------------------
plot(showRvol ? rvol : na, "RVOL", linewidth=2)
plot(showEfficiency ? priceEfficiency : na, "Price Efficiency", linewidth=2)

plotshape(showStateMarks and state == "ABSORPTION_BULLISH", title="Bullish Absorption", style=shape.triangleup, location=location.bottom, size=size.tiny, text="AB+")
plotshape(showStateMarks and state == "ABSORPTION_BEARISH", title="Bearish Absorption", style=shape.triangledown, location=location.top, size=size.tiny, text="AB-")
plotshape(showStateMarks and str.startswith(state, "EXPANSION"), title="Efficient Expansion", style=shape.circle, location=location.bottom, size=size.tiny, text="EXP")
plotshape(showStateMarks and str.startswith(state, "VACUUM"), title="Liquidity Vacuum", style=shape.square, location=location.bottom, size=size.tiny, text="VAC")
plotshape(showStateMarks and state == "COMPRESSION", title="Compression", style=shape.xcross, location=location.bottom, size=size.tiny, text="CMP")

//------------------------------------------------------------------------------
// Diagnostic table
//------------------------------------------------------------------------------
var table diag = table.new(position.top_right, 2, 15, border_width=1, frame_width=1, bgcolor=color.new(color.black, 15))

f_setRow(int row, string labelText, string valueText) =>
    table.cell(diag, 0, row, labelText, text_color=color.silver, bgcolor=color.new(color.black, 15), text_halign=text.align_left)
    table.cell(diag, 1, row, valueText, text_color=color.white, bgcolor=color.new(color.black, 15), text_halign=text.align_right)

if barstate.islast
    if showTable
        table.clear(diag, 0, 0, 1, 14)
        f_setRow(0, "PLUTUS", "P01.1")
        f_setRow(1, "Volume Type", str.tostring(volumeType))
        f_setRow(2, "RVOL", not na(rvol) ? str.tostring(rvol, "#.##") : "N/A")
        f_setRow(3, "Vol Z", not na(volZ) ? str.tostring(volZ, "#.##") : "N/A")
        f_setRow(4, "Body / ATR", not na(bodyAtr) ? str.tostring(bodyAtr, "#.##") : "N/A")
        f_setRow(5, "Range / ATR", not na(rangeAtr) ? str.tostring(rangeAtr, "#.##") : "N/A")
        f_setRow(6, "Disp / ATR", not na(displacementAtr) ? str.tostring(displacementAtr, "#.##") : "N/A")
        f_setRow(7, "Close Location", str.tostring(closeLocation, "#.##"))
        f_setRow(8, "Price Efficiency", not na(priceEfficiency) ? str.tostring(priceEfficiency, "#.##") : "N/A")
        f_setRow(9, "High Effort", highEffort ? "YES" : "NO")
        f_setRow(10, "Low Effort", lowEffort ? "YES" : "NO")
        f_setRow(11, "High Result", highDirectionalResult ? "YES" : "NO")
        f_setRow(12, "Low Result", lowDirectionalResult ? "YES" : "NO")
        f_setRow(13, "Confirm Bars", str.tostring(persistenceBars))
        f_setRow(14, "State", state)
    else
        table.clear(diag, 0, 0, 1, 14)
