//@version=6
indicator("PLUTUS P01.2 — Footprint Enhancement", shorttitle="PLUTUS P01.2", overlay=false, max_labels_count=100)

//==============================================================================
// PLUTUS P01.2 — Footprint Enhancement
// Purpose: extend the universal P01 volume/effort-result model with native
//          TradingView footprint data while preserving graceful degradation.
//==============================================================================

//------------------------------------------------------------------------------
// Inputs
//------------------------------------------------------------------------------
groupVolume = "Volume Normalization"
volBaselineMode = input.string("SMA", "Baseline Type", options=["SMA", "EMA"], group=groupVolume)
volBaselineLen  = input.int(20, "Baseline Length", minval=2, group=groupVolume)
volZLen         = input.int(50, "Z-Score Length", minval=5, group=groupVolume)
rvolLow         = input.float(0.70, "Low Effort RVOL <", minval=0.0, step=0.05, group=groupVolume)
rvolHigh        = input.float(1.20, "High Effort RVOL >=", minval=0.0, step=0.05, group=groupVolume)
volZAbnormal    = input.float(1.50, "Abnormal Volume Z >=", minval=0.0, step=0.10, group=groupVolume)

groupResult = "Price Result"
atrLen          = input.int(14, "ATR Length", minval=1, group=groupResult)
bodyHigh        = input.float(0.80, "High Body / ATR >=", minval=0.0, step=0.05, group=groupResult)
rangeHigh       = input.float(1.00, "High Range / ATR >=", minval=0.0, step=0.05, group=groupResult)
bodyLow         = input.float(0.35, "Low Body / ATR <=", minval=0.0, step=0.05, group=groupResult)
rangeLow        = input.float(0.65, "Low Range / ATR <=", minval=0.0, step=0.05, group=groupResult)
closeExtremePct = input.float(0.20, "Close Near Extreme %", minval=0.01, maxval=0.49, step=0.01, group=groupResult)

groupFootprint = "Footprint"
ticksPerRow     = input.int(100, "Ticks Per Row", minval=1, group=groupFootprint)
vaPercent       = input.float(70.0, "Value Area %", minval=1.0, maxval=100.0, step=1.0, group=groupFootprint)
imbalancePct    = input.float(300.0, "Imbalance %", minval=1.0, step=25.0, group=groupFootprint)
deltaDominance  = input.float(0.15, "Dominant Delta %", minval=0.01, maxval=1.0, step=0.01, group=groupFootprint)
imbalanceDensityMin = input.float(0.25, "Imbalance Density >=", minval=0.0, maxval=1.0, step=0.05, group=groupFootprint)

groupContext = "Context / Persistence"
persistenceBars = input.int(2, "Confirmation Bars", minval=1, maxval=5, group=groupContext)
useZConfirm     = input.bool(true, "Use Z-Score as High-Effort Confirmation", group=groupContext)

groupDisplay = "Display"
showTable       = input.bool(true, "Show Diagnostic Table", group=groupDisplay)
showStateMarks  = input.bool(false, "Show State Markers", group=groupDisplay)
showDelta       = input.bool(false, "Plot Delta %", group=groupDisplay)
showRvol        = input.bool(false, "Plot RVOL", group=groupDisplay)

//------------------------------------------------------------------------------
// Universal volume normalization
//------------------------------------------------------------------------------
volumeAvailable = not na(volume)
volumeType = syminfo.volumetype

float volBaseline = switch volBaselineMode
    "EMA" => ta.ema(volume, volBaselineLen)
    => ta.sma(volume, volBaselineLen)

float rvol = volumeAvailable and not na(volBaseline) and volBaseline != 0.0 ? volume / volBaseline : na
float volMean = ta.sma(volume, volZLen)
float volStdev = ta.stdev(volume, volZLen)
float volZ = volumeAvailable and not na(volMean) and not na(volStdev) and volStdev != 0.0 ? (volume - volMean) / volStdev : na

//------------------------------------------------------------------------------
// Price-result measurements
//------------------------------------------------------------------------------
float atr = ta.atr(atrLen)
float body = math.abs(close - open)
float tr = ta.tr(true)
float bodyAtr = not na(atr) and atr != 0.0 ? body / atr : na
float rangeAtr = not na(atr) and atr != 0.0 ? tr / atr : na
float displacementAtr = not na(atr) and atr != 0.0 ? math.abs(close - close[1]) / atr : na
float barRange = high - low
float closeLocation = barRange > 0.0 ? (close - low) / barRange : 0.5
bool closeNearHigh = closeLocation >= 1.0 - closeExtremePct
bool closeNearLow  = closeLocation <= closeExtremePct
bool bullishBar = close > open
bool bearishBar = close < open

bool abnormalZ = not na(volZ) and volZ >= volZAbnormal
bool highEffort = not na(rvol) and (rvol >= rvolHigh or (useZConfirm and abnormalZ))
bool lowEffort = not na(rvol) and rvol < rvolLow
bool highDirectionalResult = not na(bodyAtr) and not na(rangeAtr) and bodyAtr >= bodyHigh and rangeAtr >= rangeHigh
bool lowDirectionalResult  = not na(bodyAtr) and not na(rangeAtr) and bodyAtr <= bodyLow and rangeAtr <= rangeLow
bool directionalClose = (bullishBar and closeNearHigh) or (bearishBar and closeNearLow)

//------------------------------------------------------------------------------
// Native footprint request — exactly ONE request in this script.
//------------------------------------------------------------------------------
footprint fp = request.footprint(ticksPerRow, vaPercent, imbalancePct)
bool hasFootprint = not na(fp)

float fpTotal = na
float fpBuy = na
float fpSell = na
float fpDelta = na
float fpDeltaPct = na
float fpPocTop = na
float fpPocBottom = na
float fpVah = na
float fpVal = na
int fpRowsCount = 0
int buyImbalanceCount = 0
int sellImbalanceCount = 0
float buyImbalanceDensity = na
float sellImbalanceDensity = na

if hasFootprint
    fpTotal := fp.total_volume()
    fpBuy := fp.buy_volume()
    fpSell := fp.sell_volume()
    fpDelta := fp.delta()
    fpDeltaPct := fpTotal != 0.0 ? fpDelta / fpTotal : na

    volume_row pocRow = fp.poc()
    volume_row vahRow = fp.vah()
    volume_row valRow = fp.val()

    if not na(pocRow)
        fpPocTop := pocRow.up_price()
        fpPocBottom := pocRow.down_price()
    if not na(vahRow)
        fpVah := vahRow.up_price()
    if not na(valRow)
        fpVal := valRow.down_price()

    array<volume_row> fpRows = fp.rows()
    fpRowsCount := array.size(fpRows)
    if fpRowsCount > 0
        for row in fpRows
            if row.has_buy_imbalance()
                buyImbalanceCount += 1
            if row.has_sell_imbalance()
                sellImbalanceCount += 1
        buyImbalanceDensity := float(buyImbalanceCount) / float(fpRowsCount)
        sellImbalanceDensity := float(sellImbalanceCount) / float(fpRowsCount)

//------------------------------------------------------------------------------
// Footprint directional interpretation
//------------------------------------------------------------------------------
bool dominantBuyDelta = hasFootprint and not na(fpDeltaPct) and fpDeltaPct >= deltaDominance
bool dominantSellDelta = hasFootprint and not na(fpDeltaPct) and fpDeltaPct <= -deltaDominance
bool denseBuyImbalance = hasFootprint and not na(buyImbalanceDensity) and buyImbalanceDensity >= imbalanceDensityMin
bool denseSellImbalance = hasFootprint and not na(sellImbalanceDensity) and sellImbalanceDensity >= imbalanceDensityMin

string footprintBias = "UNAVAILABLE"
if hasFootprint
    footprintBias := dominantBuyDelta and denseBuyImbalance ? "BUY_STRONG" :
         dominantSellDelta and denseSellImbalance ? "SELL_STRONG" :
         dominantBuyDelta ? "BUY_DELTA" :
         dominantSellDelta ? "SELL_DELTA" :
         denseBuyImbalance ? "BUY_IMBALANCE" :
         denseSellImbalance ? "SELL_IMBALANCE" :
         "BALANCED"

//------------------------------------------------------------------------------
// P01.1 base candidates
//------------------------------------------------------------------------------
bool baseExpansionCandidate = highEffort and highDirectionalResult and directionalClose
bool baseBullAbsCandidate = highEffort and bearishBar and (lowDirectionalResult or closeNearHigh)
bool baseBearAbsCandidate = highEffort and bullishBar and (lowDirectionalResult or closeNearLow)
bool baseVacuumCandidate = lowEffort and highDirectionalResult and directionalClose
bool baseCompressionCandidate = lowEffort and lowDirectionalResult

//------------------------------------------------------------------------------
// Footprint-enhanced candidates
// Aggressive selling without proportional downside progress -> bullish absorption.
// Aggressive buying without proportional upside progress -> bearish absorption.
//------------------------------------------------------------------------------
bool fpBullAbsCandidate = hasFootprint and dominantSellDelta and highEffort and (lowDirectionalResult or closeLocation >= 0.50)
bool fpBearAbsCandidate = hasFootprint and dominantBuyDelta and highEffort and (lowDirectionalResult or closeLocation <= 0.50)

bool bullAbsCandidate = hasFootprint ? (baseBullAbsCandidate or fpBullAbsCandidate) : baseBullAbsCandidate
bool bearAbsCandidate = hasFootprint ? (baseBearAbsCandidate or fpBearAbsCandidate) : baseBearAbsCandidate

// Expansion gains footprint confirmation when order flow agrees with price direction.
bool fpExpansionConfirm = not hasFootprint or (bullishBar and (dominantBuyDelta or denseBuyImbalance)) or (bearishBar and (dominantSellDelta or denseSellImbalance))
bool expansionCandidate = baseExpansionCandidate and fpExpansionConfirm

// Vacuum remains a universal-core concept. Footprint availability is diagnostic;
// low RVOL + high price result can still describe thin participation.
bool vacuumCandidate = baseVacuumCandidate
bool compressionCandidate = baseCompressionCandidate

//------------------------------------------------------------------------------
// Persistence helper
//------------------------------------------------------------------------------
f_confirm(bool condition, int bars) =>
    float persistenceRatio = ta.sma(condition ? 1.0 : 0.0, bars)
    not na(persistenceRatio) and persistenceRatio >= 1.0

bool expansion = f_confirm(expansionCandidate, persistenceBars)
bool bullAbsorption = f_confirm(bullAbsCandidate, persistenceBars)
bool bearAbsorption = f_confirm(bearAbsCandidate, persistenceBars)
bool vacuum = f_confirm(vacuumCandidate, persistenceBars)
bool compression = f_confirm(compressionCandidate, persistenceBars)

//------------------------------------------------------------------------------
// Primary state
//------------------------------------------------------------------------------
string state = "NEUTRAL"
if not volumeAvailable or na(rvol) or na(bodyAtr) or na(rangeAtr)
    state := "UNAVAILABLE"
else if bullAbsorption
    state := hasFootprint ? "FP_ABSORPTION_BULLISH" : "ABSORPTION_BULLISH"
else if bearAbsorption
    state := hasFootprint ? "FP_ABSORPTION_BEARISH" : "ABSORPTION_BEARISH"
else if expansion
    state := bullishBar ? "FP_EXPANSION_BULLISH" : bearishBar ? "FP_EXPANSION_BEARISH" : "FP_EXPANSION"
else if vacuum
    state := bullishBar ? "VACUUM_BULLISH" : bearishBar ? "VACUUM_BEARISH" : "LIQUIDITY_VACUUM"
else if compression
    state := "COMPRESSION"

//------------------------------------------------------------------------------
// Optional diagnostics
//------------------------------------------------------------------------------
plot(showRvol ? rvol : na, "RVOL", linewidth=2)
plot(showDelta ? fpDeltaPct : na, "Footprint Delta %", linewidth=2)
hline(0.0, "Delta Zero", color=color.new(color.gray, 70))

plotshape(showStateMarks and str.contains(state, "ABSORPTION_BULLISH"), title="Bullish Absorption", style=shape.triangleup, location=location.bottom, size=size.tiny, text="AB+")
plotshape(showStateMarks and str.contains(state, "ABSORPTION_BEARISH"), title="Bearish Absorption", style=shape.triangledown, location=location.top, size=size.tiny, text="AB-")
plotshape(showStateMarks and str.contains(state, "EXPANSION"), title="Expansion", style=shape.circle, location=location.bottom, size=size.tiny, text="EXP")

//------------------------------------------------------------------------------
// Diagnostic table
//------------------------------------------------------------------------------
var table diag = table.new(position.top_right, 2, 19, border_width=1, frame_width=1, bgcolor=color.new(color.black, 15))

f_setRow(int row, string labelText, string valueText) =>
    table.cell(diag, 0, row, labelText, text_color=color.silver, bgcolor=color.new(color.black, 15), text_halign=text.align_left)
    table.cell(diag, 1, row, valueText, text_color=color.white, bgcolor=color.new(color.black, 15), text_halign=text.align_right)

if barstate.islast
    if showTable
        table.clear(diag, 0, 0, 1, 18)
        f_setRow(0, "PLUTUS", "P01.2")
        f_setRow(1, "Volume Type", str.tostring(volumeType))
        f_setRow(2, "RVOL", not na(rvol) ? str.tostring(rvol, "#.##") : "N/A")
        f_setRow(3, "Vol Z", not na(volZ) ? str.tostring(volZ, "#.##") : "N/A")
        f_setRow(4, "Body / ATR", not na(bodyAtr) ? str.tostring(bodyAtr, "#.##") : "N/A")
        f_setRow(5, "Range / ATR", not na(rangeAtr) ? str.tostring(rangeAtr, "#.##") : "N/A")
        f_setRow(6, "Footprint", hasFootprint ? "AVAILABLE" : "N/A")
        f_setRow(7, "Buy Volume", not na(fpBuy) ? str.tostring(fpBuy, format.volume) : "N/A")
        f_setRow(8, "Sell Volume", not na(fpSell) ? str.tostring(fpSell, format.volume) : "N/A")
        f_setRow(9, "Delta", not na(fpDelta) ? str.tostring(fpDelta, format.volume) : "N/A")
        f_setRow(10, "Delta %", not na(fpDeltaPct) ? str.tostring(fpDeltaPct * 100.0, "#.##") + "%" : "N/A")
        f_setRow(11, "Rows", str.tostring(fpRowsCount))
        f_setRow(12, "Buy Imb Density", not na(buyImbalanceDensity) ? str.tostring(buyImbalanceDensity * 100.0, "#.##") + "%" : "N/A")
        f_setRow(13, "Sell Imb Density", not na(sellImbalanceDensity) ? str.tostring(sellImbalanceDensity * 100.0, "#.##") + "%" : "N/A")
        f_setRow(14, "POC", not na(fpPocTop) and not na(fpPocBottom) ? str.tostring((fpPocTop + fpPocBottom) / 2.0, format.mintick) : "N/A")
        f_setRow(15, "VAH", not na(fpVah) ? str.tostring(fpVah, format.mintick) : "N/A")
        f_setRow(16, "VAL", not na(fpVal) ? str.tostring(fpVal, format.mintick) : "N/A")
        f_setRow(17, "Footprint Bias", footprintBias)
        f_setRow(18, "State", state)
    else
        table.clear(diag, 0, 0, 1, 18)
