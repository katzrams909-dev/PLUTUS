//@version=6
indicator("PLUTUS P01.3 — Unified Participation", shorttitle="PLUTUS P01.3", overlay=false, max_labels_count=100)

//==============================================================================
// PLUTUS P01.3 — Unified Participation State Engine
// Consolidates P01.0 normalization, P01.1 effort/result, and P01.2 estimated
// lower-timeframe order flow into one auditable participation-state model.
//
// IMPORTANT:
// - Estimated order flow is NOT true bid/ask footprint data.
// - Final states are emitted only on confirmed chart bars.
// - Thresholds remain prototype defaults pending cross-asset validation.
//==============================================================================

//------------------------------------------------------------------------------
// Inputs
//------------------------------------------------------------------------------
groupVolume = "Volume Normalization"
volBaselineMode = input.string("SMA", "Baseline Type", options=["SMA", "EMA"], group=groupVolume)
volBaselineLen  = input.int(20, "Baseline Length", minval=2, group=groupVolume)
volZLen         = input.int(50, "Z-Score Length", minval=5, group=groupVolume)
rvolLow         = input.float(0.70, "Contraction RVOL Threshold", minval=0.0, step=0.05, group=groupVolume)
rvolHigh        = input.float(1.20, "Expansion RVOL Threshold", minval=0.0, step=0.05, group=groupVolume)
rvolExtreme     = input.float(1.80, "Climax RVOL Threshold", minval=0.0, step=0.05, group=groupVolume)
volZHigh        = input.float(1.50, "High Volume Z Threshold", minval=0.0, step=0.10, group=groupVolume)
volZExtreme     = input.float(2.00, "Extreme Volume Z Threshold", minval=0.0, step=0.10, group=groupVolume)

groupResult = "Price Result"
atrLen          = input.int(14, "ATR Length", minval=1, group=groupResult)
bodyHigh        = input.float(0.80, "High Body / ATR Threshold", minval=0.0, step=0.05, group=groupResult)
rangeHigh       = input.float(1.00, "High Range / ATR Threshold", minval=0.0, step=0.05, group=groupResult)
bodyLow         = input.float(0.35, "Low Body / ATR Threshold", minval=0.0, step=0.05, group=groupResult)
rangeLow        = input.float(0.65, "Low Range / ATR Threshold", minval=0.0, step=0.05, group=groupResult)
closeExtremePct = input.float(0.20, "Close Near Extreme %", minval=0.01, maxval=0.49, step=0.01, group=groupResult)
climaxRange     = input.float(1.40, "Climax Range / ATR Threshold", minval=0.5, step=0.05, group=groupResult)

groupProxy = "Estimated Order Flow"
ltfTf           = input.timeframe("1", "Lower Timeframe", group=groupProxy)
deltaThreshold  = input.float(0.20, "Strong Delta % Threshold", minval=0.01, maxval=1.0, step=0.05, group=groupProxy)
requireFlowForExpansion = input.bool(true, "Require Flow Agreement For Expansion", group=groupProxy)

groupContext = "Context / Persistence"
persistenceBars = input.int(2, "Confirmation Bars", minval=1, maxval=5, group=groupContext)
useZConfirm     = input.bool(true, "Use Z-Score In Effort Score", group=groupContext)
exhaustionLookback = input.int(3, "Exhaustion Trend Lookback", minval=1, maxval=10, group=groupContext)

groupDisplay = "Display"
showTable       = input.bool(true, "Show Diagnostic Table", group=groupDisplay)
showStateMarks  = input.bool(false, "Show State Markers", group=groupDisplay)
showScore       = input.bool(false, "Plot Net Participation Score", group=groupDisplay)
showDelta       = input.bool(false, "Plot Estimated Delta %", group=groupDisplay)

//------------------------------------------------------------------------------
// P01.0 — Volume normalization
//------------------------------------------------------------------------------
volumeAvailable = not na(volume)
volumeType = syminfo.volumetype

float volBaseline = switch volBaselineMode
    "EMA" => ta.ema(volume, volBaselineLen)
    => ta.sma(volume, volBaselineLen)

float rvol = volumeAvailable and not na(volBaseline) and volBaseline != 0.0 ? volume / volBaseline : na
float volMean = ta.sma(volume, volZLen)
float volStdev = ta.stdev(volume, volZLen)
float volZ = volumeAvailable and not na(volMean) and not na(volStdev) and volStdev != 0.0 ? (volume - volMean) / volStdev : na

bool contractionEffort = not na(rvol) and rvol < rvolLow
bool expansionEffort = not na(rvol) and rvol >= rvolHigh
bool extremeEffort = not na(rvol) and rvol >= rvolExtreme
bool highZ = not na(volZ) and volZ >= volZHigh
bool extremeZ = not na(volZ) and volZ >= volZExtreme
bool highEffort = expansionEffort or (useZConfirm and highZ)

//------------------------------------------------------------------------------
// P01.1 — Price result and efficiency
//------------------------------------------------------------------------------
float atr = ta.atr(atrLen)
float body = math.abs(close - open)
float trueRange = ta.tr(true)
float bodyAtr = not na(atr) and atr != 0.0 ? body / atr : na
float rangeAtr = not na(atr) and atr != 0.0 ? trueRange / atr : na
float displacementAtr = not na(atr) and atr != 0.0 ? math.abs(close - close[1]) / atr : na

float barRange = high - low
float closeLocation = barRange > 0.0 ? (close - low) / barRange : 0.5
bool bullishBar = close > open
bool bearishBar = close < open
bool closeNearHigh = closeLocation >= 1.0 - closeExtremePct
bool closeNearLow = closeLocation <= closeExtremePct
bool directionalClose = (bullishBar and closeNearHigh) or (bearishBar and closeNearLow)

bool highResult = not na(bodyAtr) and not na(rangeAtr) and bodyAtr >= bodyHigh and rangeAtr >= rangeHigh
bool lowResult = not na(bodyAtr) and not na(rangeAtr) and bodyAtr <= bodyLow and rangeAtr <= rangeLow

float priceEfficiency = na
if not na(bodyAtr) and not na(rangeAtr) and not na(displacementAtr)
    priceEfficiency := (bodyAtr + rangeAtr + displacementAtr) / 3.0

//------------------------------------------------------------------------------
// P01.2 — Lower-timeframe estimated directional flow
//------------------------------------------------------------------------------
ltfOpen = request.security_lower_tf(syminfo.tickerid, ltfTf, open, ignore_invalid_timeframe=true)
ltfClose = request.security_lower_tf(syminfo.tickerid, ltfTf, close, ignore_invalid_timeframe=true)
ltfVolume = request.security_lower_tf(syminfo.tickerid, ltfTf, volume, ignore_invalid_timeframe=true)

int intrabarCount = math.min(array.size(ltfOpen), math.min(array.size(ltfClose), array.size(ltfVolume)))
float estBuyVolume = 0.0
float estSellVolume = 0.0

if intrabarCount > 0
    for i = 0 to intrabarCount - 1
        float io = array.get(ltfOpen, i)
        float ic = array.get(ltfClose, i)
        float iv = array.get(ltfVolume, i)
        if not na(iv)
            if ic > io
                estBuyVolume += iv
            else if ic < io
                estSellVolume += iv
            else
                estBuyVolume += iv * 0.5
                estSellVolume += iv * 0.5

float estTotalVolume = estBuyVolume + estSellVolume
float estDelta = estBuyVolume - estSellVolume
float estDeltaPct = estTotalVolume > 0.0 ? estDelta / estTotalVolume : na
bool proxyAvailable = intrabarCount > 0 and estTotalVolume > 0.0 and not na(estDeltaPct)
bool proxyBullish = proxyAvailable and estDeltaPct >= deltaThreshold
bool proxyBearish = proxyAvailable and estDeltaPct <= -deltaThreshold
bool proxyBalanced = proxyAvailable and math.abs(estDeltaPct) < deltaThreshold

//------------------------------------------------------------------------------
// Component scores — diagnostic API for downstream engines
//------------------------------------------------------------------------------
int effortScore = 0
if not na(rvol)
    effortScore += rvol >= rvolExtreme ? 3 : rvol >= rvolHigh ? 2 : rvol >= rvolLow ? 1 : 0
if useZConfirm and highZ
    effortScore += extremeZ ? 2 : 1

int resultScore = 0
if highResult
    resultScore += 2
else if not lowResult
    resultScore += 1
if directionalClose
    resultScore += 1

int flowScore = 0
if proxyBullish
    flowScore := 2
else if proxyBearish
    flowScore := -2
else if proxyBalanced
    flowScore := 0

int directionScore = bullishBar ? 1 : bearishBar ? -1 : 0
int netParticipationScore = directionScore * effortScore + flowScore

//------------------------------------------------------------------------------
// Candidate events
//------------------------------------------------------------------------------
bool expansionFlowAgreement = not proxyAvailable or not requireFlowForExpansion or (bullishBar and proxyBullish) or (bearishBar and proxyBearish)
bool expansionCandidate = highEffort and highResult and directionalClose and expansionFlowAgreement

bool downsideFailure = lowResult or closeLocation >= 0.50
bool upsideFailure = lowResult or closeLocation <= 0.50
bool bullishAbsorptionCandidate = highEffort and proxyBearish and downsideFailure
bool bearishAbsorptionCandidate = highEffort and proxyBullish and upsideFailure

bool vacuumCandidate = contractionEffort and highResult and directionalClose
bool compressionCandidate = contractionEffort and lowResult
bool climaxCandidate = (extremeEffort or extremeZ) and not na(rangeAtr) and rangeAtr >= climaxRange

// Exhaustion is defined as extreme effort in the direction of an existing move,
// but reduced current-bar efficiency or failure to close near the directional
// extreme. The state name describes the move being exhausted.
float trendChange = close - close[exhaustionLookback]
bool priorUpMove = not na(trendChange) and trendChange > 0.0
bool priorDownMove = not na(trendChange) and trendChange < 0.0
bool bullishMoveFailure = bullishBar and (lowResult or not closeNearHigh)
bool bearishMoveFailure = bearishBar and (lowResult or not closeNearLow)
bool bullishExhaustionCandidate = (extremeEffort or extremeZ) and priorUpMove and bullishMoveFailure and (not proxyAvailable or proxyBullish)
bool bearishExhaustionCandidate = (extremeEffort or extremeZ) and priorDownMove and bearishMoveFailure and (not proxyAvailable or proxyBearish)

//------------------------------------------------------------------------------
// Persistence helper
//------------------------------------------------------------------------------
f_confirm(bool condition, int bars) =>
    float ratio = ta.sma(condition ? 1.0 : 0.0, bars)
    not na(ratio) and ratio >= 1.0

bool expansionConfirmed = f_confirm(expansionCandidate, persistenceBars)
bool bullishAbsorption = f_confirm(bullishAbsorptionCandidate, persistenceBars)
bool bearishAbsorption = f_confirm(bearishAbsorptionCandidate, persistenceBars)
bool vacuumConfirmed = f_confirm(vacuumCandidate, persistenceBars)
bool compressionConfirmed = f_confirm(compressionCandidate, persistenceBars)
bool climaxConfirmed = f_confirm(climaxCandidate, persistenceBars)
bool bullishExhaustion = f_confirm(bullishExhaustionCandidate, persistenceBars)
bool bearishExhaustion = f_confirm(bearishExhaustionCandidate, persistenceBars)

//------------------------------------------------------------------------------
// Unified state precedence
// 1 unavailable
// 2 absorption
// 3 exhaustion
// 4 climax
// 5 liquidity vacuum
// 6 efficient expansion
// 7 compression
// 8 contraction
// 9 normal
//------------------------------------------------------------------------------
string candidateState = "NORMAL"
if not volumeAvailable or na(rvol) or na(bodyAtr) or na(rangeAtr)
    candidateState := "UNAVAILABLE"
else if bullishAbsorption
    candidateState := "ABSORPTION_BULLISH"
else if bearishAbsorption
    candidateState := "ABSORPTION_BEARISH"
else if bullishExhaustion
    candidateState := "EXHAUSTION_BULLISH_MOVE"
else if bearishExhaustion
    candidateState := "EXHAUSTION_BEARISH_MOVE"
else if climaxConfirmed
    candidateState := "CLIMAX"
else if vacuumConfirmed
    candidateState := bullishBar ? "VACUUM_BULLISH" : bearishBar ? "VACUUM_BEARISH" : "LIQUIDITY_VACUUM"
else if expansionConfirmed
    candidateState := bullishBar ? "EXPANSION_BULLISH" : bearishBar ? "EXPANSION_BEARISH" : "EXPANSION"
else if compressionConfirmed
    candidateState := "COMPRESSION"
else if contractionEffort
    candidateState := "CONTRACTION"

string state = barstate.isconfirmed ? candidateState : "FORMING"

//------------------------------------------------------------------------------
// Diagnostics
//------------------------------------------------------------------------------
plot(showScore ? netParticipationScore : na, "Net Participation Score", linewidth=2)
plot(showDelta ? estDeltaPct : na, "Estimated Delta %", linewidth=2)
hline(0.0, "Zero", color=color.new(color.gray, 65), linestyle=hline.style_dotted)

plotshape(showStateMarks and state == "ABSORPTION_BULLISH", title="Bullish Absorption", style=shape.triangleup, location=location.bottom, size=size.tiny, text="AB+")
plotshape(showStateMarks and state == "ABSORPTION_BEARISH", title="Bearish Absorption", style=shape.triangledown, location=location.top, size=size.tiny, text="AB-")
plotshape(showStateMarks and str.startswith(state, "EXPANSION"), title="Expansion", style=shape.circle, location=location.bottom, size=size.tiny, text="EXP")
plotshape(showStateMarks and str.startswith(state, "VACUUM"), title="Vacuum", style=shape.square, location=location.bottom, size=size.tiny, text="VAC")
plotshape(showStateMarks and str.startswith(state, "EXHAUSTION"), title="Exhaustion", style=shape.diamond, location=location.bottom, size=size.tiny, text="EXH")
plotshape(showStateMarks and state == "CLIMAX", title="Climax", style=shape.flag, location=location.bottom, size=size.tiny, text="CLX")
plotshape(showStateMarks and state == "COMPRESSION", title="Compression", style=shape.xcross, location=location.bottom, size=size.tiny, text="CMP")

//------------------------------------------------------------------------------
// Diagnostic table
//------------------------------------------------------------------------------
var table diag = table.new(position.top_right, 2, 22, border_width=1, frame_width=1, bgcolor=color.new(color.black, 15))

f_setRow(int row, string labelText, string valueText) =>
    table.cell(diag, 0, row, labelText, text_color=color.silver, bgcolor=color.new(color.black, 15), text_halign=text.align_left)
    table.cell(diag, 1, row, valueText, text_color=color.white, bgcolor=color.new(color.black, 15), text_halign=text.align_right)

if barstate.islast
    if showTable
        table.clear(diag, 0, 0, 1, 21)
        f_setRow(0, "PLUTUS", "P01.3 Unified")
        f_setRow(1, "Volume Type", str.tostring(volumeType))
        f_setRow(2, "Lower TF", ltfTf)
        f_setRow(3, "Intrabars", str.tostring(intrabarCount))
        f_setRow(4, "RVOL", not na(rvol) ? str.tostring(rvol, "#.##") : "N/A")
        f_setRow(5, "Vol Z", not na(volZ) ? str.tostring(volZ, "#.##") : "N/A")
        f_setRow(6, "Body / ATR", not na(bodyAtr) ? str.tostring(bodyAtr, "#.##") : "N/A")
        f_setRow(7, "Range / ATR", not na(rangeAtr) ? str.tostring(rangeAtr, "#.##") : "N/A")
        f_setRow(8, "Disp / ATR", not na(displacementAtr) ? str.tostring(displacementAtr, "#.##") : "N/A")
        f_setRow(9, "Close Location", str.tostring(closeLocation, "#.##"))
        f_setRow(10, "Price Efficiency", not na(priceEfficiency) ? str.tostring(priceEfficiency, "#.##") : "N/A")
        f_setRow(11, "Est Delta %", proxyAvailable ? str.tostring(estDeltaPct * 100.0, "#.##") + "%" : "N/A")
        f_setRow(12, "Flow Bias", proxyBullish ? "BULLISH" : proxyBearish ? "BEARISH" : proxyBalanced ? "BALANCED" : "N/A")
        f_setRow(13, "Effort Score", str.tostring(effortScore))
        f_setRow(14, "Result Score", str.tostring(resultScore))
        f_setRow(15, "Flow Score", str.tostring(flowScore))
        f_setRow(16, "Net Score", str.tostring(netParticipationScore))
        f_setRow(17, "High Effort", highEffort ? "YES" : "NO")
        f_setRow(18, "Extreme Effort", (extremeEffort or extremeZ) ? "YES" : "NO")
        f_setRow(19, "Confirm Bars", str.tostring(persistenceBars))
        f_setRow(20, "Confirmed Bar", barstate.isconfirmed ? "YES" : "NO")
        f_setRow(21, "State", state)
    else
        table.clear(diag, 0, 0, 1, 21)
