//@version=6
indicator("PLUTUS P02.2 — VWAP Deviation Bands", shorttitle="PLUTUS P02.2", overlay=true, max_labels_count=100)

//==============================================================================
// PLUTUS P02.2 — VWAP Deviation Bands
// Builds on P02.1 and adds a spatial fair-value framework around the selected
// VWAP reference. This is context only; no trade signals are generated.
//==============================================================================

//------------------------------------------------------------------------------
// Inputs
//------------------------------------------------------------------------------
groupSource = "VWAP Source"
source = input.source(hlc3, "Source", group=groupSource)

groupTiming = "Timing / Timezone"
timezoneInput = input.string("Exchange", "Session Timezone", options=["Exchange", "UTC-2", "UTC-1", "UTC+0", "UTC+1", "UTC+2", "America/New_York", "Europe/London", "Asia/Tokyo"], group=groupTiming)
string sessionTz = timezoneInput == "Exchange" ? syminfo.timezone : timezoneInput

groupSessions = "Fixed Session VWAPs"
showAsiaVwap = input.bool(true, "Show Asia VWAP", group=groupSessions)
showLondonVwap = input.bool(true, "Show London VWAP", group=groupSessions)
showNewYorkVwap = input.bool(true, "Show New York VWAP", group=groupSessions)

groupHigher = "Higher-Period VWAPs"
showDailyVwap = input.bool(true, "Show Daily VWAP", group=groupHigher)
showWeeklyVwap = input.bool(true, "Show Weekly VWAP", group=groupHigher)
showMonthlyVwap = input.bool(true, "Show Monthly VWAP", group=groupHigher)

groupModel = "Value Migration Model"
referenceMode = input.string("Daily", "Primary Value Reference", options=["Active Session", "Daily", "Weekly", "Monthly"], group=groupModel)
atrLen = input.int(14, "ATR Length", minval=1, group=groupModel)
slopeLookback = input.int(5, "VWAP Slope Lookback", minval=1, maxval=50, group=groupModel)
slopeAtrThreshold = input.float(0.10, "Directional Slope / ATR Threshold", minval=0.0, step=0.01, group=groupModel)
acceptanceBars = input.int(5, "Acceptance Lookback", minval=2, maxval=50, group=groupModel)
acceptanceRatioMin = input.float(0.80, "Acceptance Ratio", minval=0.50, maxval=1.0, step=0.05, group=groupModel)
crossLookback = input.int(10, "Equilibrium Cross Lookback", minval=3, maxval=50, group=groupModel)
minCrosses = input.int(3, "Minimum Crosses For Equilibrium", minval=1, maxval=20, group=groupModel)
equilibriumDistanceAtr = input.float(0.35, "Equilibrium Max Distance / ATR", minval=0.05, step=0.05, group=groupModel)
failureDistanceAtr = input.float(0.15, "Migration Failure Distance / ATR", minval=0.0, step=0.05, group=groupModel)

groupBands = "Deviation Bands"
bandBasis = input.string("ATR", "Band Basis", options=["ATR", "StdDev"], group=groupBands)
stdLen = input.int(20, "StdDev Length", minval=2, group=groupBands)
innerMult = input.float(1.00, "Inner Band Multiplier", minval=0.10, step=0.10, group=groupBands)
outerMult = input.float(2.00, "Outer Band Multiplier", minval=0.20, step=0.10, group=groupBands)
showInnerBands = input.bool(true, "Show Inner Bands", group=groupBands)
showOuterBands = input.bool(true, "Show Outer Bands", group=groupBands)
showBandFill = input.bool(true, "Shade Inner Value Area", group=groupBands)

groupDisplay = "Display"
showTable = input.bool(true, "Show Diagnostic Table", group=groupDisplay)
lineWidth = input.int(2, "Line Width", minval=1, maxval=4, group=groupDisplay)
breakLinesOnReset = input.bool(true, "Break Lines On Reset", group=groupDisplay)

//------------------------------------------------------------------------------
// Fixed ARTHA sessions
//------------------------------------------------------------------------------
string asiaSession = "0000-0800:1234567"
string londonSession = "0800-1630:1234567"
string newYorkSession = "1330-2000:1234567"

bool inAsia = not na(time(timeframe.period, asiaSession, sessionTz))
bool inLondon = not na(time(timeframe.period, londonSession, sessionTz))
bool inNewYork = not na(time(timeframe.period, newYorkSession, sessionTz))

bool newAsia = inAsia and not inAsia[1]
bool newLondon = inLondon and not inLondon[1]
bool newNewYork = inNewYork and not inNewYork[1]

//------------------------------------------------------------------------------
// Fixed-session VWAPs
//------------------------------------------------------------------------------
var float asiaPV = na
var float asiaVol = na
if not inAsia
    asiaPV := na
    asiaVol := na
else if newAsia or na(asiaPV) or na(asiaVol)
    asiaPV := source * volume
    asiaVol := volume
else
    asiaPV += source * volume
    asiaVol += volume
float asiaVwap = inAsia and not na(asiaVol) and asiaVol > 0.0 ? asiaPV / asiaVol : na

var float londonPV = na
var float londonVol = na
if not inLondon
    londonPV := na
    londonVol := na
else if newLondon or na(londonPV) or na(londonVol)
    londonPV := source * volume
    londonVol := volume
else
    londonPV += source * volume
    londonVol += volume
float londonVwap = inLondon and not na(londonVol) and londonVol > 0.0 ? londonPV / londonVol : na

var float newYorkPV = na
var float newYorkVol = na
if not inNewYork
    newYorkPV := na
    newYorkVol := na
else if newNewYork or na(newYorkPV) or na(newYorkVol)
    newYorkPV := source * volume
    newYorkVol := volume
else
    newYorkPV += source * volume
    newYorkVol += volume
float newYorkVwap = inNewYork and not na(newYorkVol) and newYorkVol > 0.0 ? newYorkPV / newYorkVol : na

//------------------------------------------------------------------------------
// D/W/M VWAPs in shared timezone
//------------------------------------------------------------------------------
int localDay = dayofmonth(time, sessionTz)
int localWeek = weekofyear(time, sessionTz)
int localMonth = month(time, sessionTz)

bool newDay = ta.change(localDay) != 0
bool newWeek = ta.change(localWeek) != 0
bool newMonth = ta.change(localMonth) != 0

float dailyVwap = ta.vwap(source, barstate.isfirst or newDay)
float weeklyVwap = ta.vwap(source, barstate.isfirst or newWeek)
float monthlyVwap = ta.vwap(source, barstate.isfirst or newMonth)

//------------------------------------------------------------------------------
// Primary fair-value reference
//------------------------------------------------------------------------------
float activeSessionVwap = inNewYork ? newYorkVwap : inLondon ? londonVwap : inAsia ? asiaVwap : na
string activeSessionName = inNewYork ? "NEW YORK" : inLondon ? "LONDON" : inAsia ? "ASIA" : "NONE"

float valueRef = switch referenceMode
    "Active Session" => activeSessionVwap
    "Weekly" => weeklyVwap
    "Monthly" => monthlyVwap
    => dailyVwap

bool refReset = switch referenceMode
    "Active Session" => newNewYork or newLondon or newAsia
    "Weekly" => newWeek
    "Monthly" => newMonth
    => newDay

//------------------------------------------------------------------------------
// P02.1 value behavior
//------------------------------------------------------------------------------
float atr = ta.atr(atrLen)
float distanceAtr = not na(valueRef) and not na(atr) and atr != 0.0 ? (close - valueRef) / atr : na
float slopeAtr = not na(valueRef) and not na(valueRef[slopeLookback]) and not na(atr) and atr != 0.0 ? (valueRef - valueRef[slopeLookback]) / atr : na

bool valueRising = not na(slopeAtr) and slopeAtr >= slopeAtrThreshold
bool valueFalling = not na(slopeAtr) and slopeAtr <= -slopeAtrThreshold
bool valueFlat = not na(slopeAtr) and not valueRising and not valueFalling

float aboveRatio = ta.sma(not na(valueRef) and close > valueRef ? 1.0 : 0.0, acceptanceBars)
float belowRatio = ta.sma(not na(valueRef) and close < valueRef ? 1.0 : 0.0, acceptanceBars)
bool acceptedAbove = not na(aboveRatio) and aboveRatio >= acceptanceRatioMin
bool acceptedBelow = not na(belowRatio) and belowRatio >= acceptanceRatioMin

bool refCross = not na(valueRef) and not na(valueRef[1]) and ((close > valueRef and close[1] <= valueRef[1]) or (close < valueRef and close[1] >= valueRef[1]))
float crossRate = ta.sma(refCross ? 1.0 : 0.0, crossLookback)
float approximateCrosses = not na(crossRate) ? crossRate * crossLookback : na
bool equilibrium = not na(approximateCrosses) and approximateCrosses >= minCrosses and not na(distanceAtr) and math.abs(distanceAtr) <= equilibriumDistanceAtr

bool risingMigrationFailure = valueRising and not na(distanceAtr) and distanceAtr <= -failureDistanceAtr
bool fallingMigrationFailure = valueFalling and not na(distanceAtr) and distanceAtr >= failureDistanceAtr

//------------------------------------------------------------------------------
// P02.2 deviation-band framework
//------------------------------------------------------------------------------
float stdDev = ta.stdev(source, stdLen)
float bandUnit = bandBasis == "StdDev" ? stdDev : atr
float innerDistance = not na(bandUnit) ? bandUnit * innerMult : na
float outerDistance = not na(bandUnit) ? bandUnit * outerMult : na

float upperInner = not na(valueRef) and not na(innerDistance) ? valueRef + innerDistance : na
float lowerInner = not na(valueRef) and not na(innerDistance) ? valueRef - innerDistance : na
float upperOuter = not na(valueRef) and not na(outerDistance) ? valueRef + outerDistance : na
float lowerOuter = not na(valueRef) and not na(outerDistance) ? valueRef - outerDistance : na

float normalizedDistance = not na(valueRef) and not na(bandUnit) and bandUnit != 0.0 ? (close - valueRef) / bandUnit : na

bool insideInner = not na(close) and not na(upperInner) and close <= upperInner and close >= lowerInner
bool upperExtension = not na(upperOuter) and close > upperOuter
bool lowerExtension = not na(lowerOuter) and close < lowerOuter
bool upperTransition = not na(upperInner) and not na(upperOuter) and close > upperInner and close <= upperOuter
bool lowerTransition = not na(lowerInner) and not na(lowerOuter) and close < lowerInner and close >= lowerOuter

bool meanReversionContext = (upperTransition and (valueFlat or valueFalling)) or (lowerTransition and (valueFlat or valueRising))

string bandState = "VALUE_AREA"
if na(valueRef) or na(bandUnit)
    bandState := "UNAVAILABLE"
else if upperExtension
    bandState := "EXTENDED_ABOVE_OUTER"
else if lowerExtension
    bandState := "EXTENDED_BELOW_OUTER"
else if upperTransition
    bandState := meanReversionContext ? "UPPER_REVERSION_CONTEXT" : "UPPER_TRANSITION"
else if lowerTransition
    bandState := meanReversionContext ? "LOWER_REVERSION_CONTEXT" : "LOWER_TRANSITION"
else if insideInner
    bandState := equilibrium ? "INNER_VALUE_EQUILIBRIUM" : "INNER_VALUE_AREA"

//------------------------------------------------------------------------------
// Combined value state
//------------------------------------------------------------------------------
string valueState = "BALANCED_VALUE"
if na(valueRef) or na(atr) or na(slopeAtr)
    valueState := "UNAVAILABLE"
else if equilibrium
    valueState := "EQUILIBRIUM"
else if risingMigrationFailure
    valueState := "RISING_VALUE_FAILURE"
else if fallingMigrationFailure
    valueState := "FALLING_VALUE_FAILURE"
else if acceptedAbove and valueRising
    valueState := "ACCEPTED_ABOVE_RISING_VALUE"
else if acceptedBelow and valueFalling
    valueState := "ACCEPTED_BELOW_FALLING_VALUE"
else if acceptedAbove
    valueState := "ACCEPTED_ABOVE_VALUE"
else if acceptedBelow
    valueState := "ACCEPTED_BELOW_VALUE"
else if valueRising
    valueState := "VALUE_RISING"
else if valueFalling
    valueState := "VALUE_FALLING"
else if valueFlat
    valueState := "BALANCED_VALUE"

//------------------------------------------------------------------------------
// Baseline plots
//------------------------------------------------------------------------------
float asiaPlot = showAsiaVwap ? asiaVwap : na
float londonPlot = showLondonVwap ? londonVwap : na
float newYorkPlot = showNewYorkVwap ? newYorkVwap : na
float dailyPlot = showDailyVwap ? dailyVwap : na
float weeklyPlot = showWeeklyVwap ? weeklyVwap : na
float monthlyPlot = showMonthlyVwap ? monthlyVwap : na

asiaPlot := breakLinesOnReset and newAsia ? na : asiaPlot
londonPlot := breakLinesOnReset and newLondon ? na : londonPlot
newYorkPlot := breakLinesOnReset and newNewYork ? na : newYorkPlot
dailyPlot := breakLinesOnReset and newDay ? na : dailyPlot
weeklyPlot := breakLinesOnReset and newWeek ? na : weeklyPlot
monthlyPlot := breakLinesOnReset and newMonth ? na : monthlyPlot

plot(asiaPlot, "Asia VWAP", linewidth=lineWidth, color=color.aqua, style=plot.style_linebr)
plot(londonPlot, "London VWAP", linewidth=lineWidth, color=color.yellow, style=plot.style_linebr)
plot(newYorkPlot, "New York VWAP", linewidth=lineWidth, color=color.orange, style=plot.style_linebr)
plot(dailyPlot, "Daily VWAP", linewidth=lineWidth, color=color.white, style=plot.style_linebr)
plot(weeklyPlot, "Weekly VWAP", linewidth=lineWidth, color=color.blue, style=plot.style_linebr)
plot(monthlyPlot, "Monthly VWAP", linewidth=lineWidth, color=color.fuchsia, style=plot.style_linebr)

//------------------------------------------------------------------------------
// Band plots — break with the selected reference reset
//------------------------------------------------------------------------------
float upperInnerPlot = showInnerBands ? upperInner : na
float lowerInnerPlot = showInnerBands ? lowerInner : na
float upperOuterPlot = showOuterBands ? upperOuter : na
float lowerOuterPlot = showOuterBands ? lowerOuter : na

upperInnerPlot := breakLinesOnReset and refReset ? na : upperInnerPlot
lowerInnerPlot := breakLinesOnReset and refReset ? na : lowerInnerPlot
upperOuterPlot := breakLinesOnReset and refReset ? na : upperOuterPlot
lowerOuterPlot := breakLinesOnReset and refReset ? na : lowerOuterPlot

pUpperInner = plot(upperInnerPlot, "Upper Inner Band", color=color.new(color.silver, 20), style=plot.style_linebr)
pLowerInner = plot(lowerInnerPlot, "Lower Inner Band", color=color.new(color.silver, 20), style=plot.style_linebr)
plot(upperOuterPlot, "Upper Outer Band", color=color.new(color.gray, 40), style=plot.style_linebr)
plot(lowerOuterPlot, "Lower Outer Band", color=color.new(color.gray, 40), style=plot.style_linebr)
fill(pUpperInner, pLowerInner, color=showBandFill ? color.new(color.gray, 90) : na, title="Inner Value Area")

//------------------------------------------------------------------------------
// Diagnostics
//------------------------------------------------------------------------------
var table diag = table.new(position.top_right, 2, 18, border_width=1, frame_width=1, bgcolor=color.new(color.black, 15))

f_setRow(int row, string labelText, string valueText) =>
    table.cell(diag, 0, row, labelText, text_color=color.silver, bgcolor=color.new(color.black, 15), text_halign=text.align_left)
    table.cell(diag, 1, row, valueText, text_color=color.white, bgcolor=color.new(color.black, 15), text_halign=text.align_right)

if barstate.islast
    if showTable
        table.clear(diag, 0, 0, 1, 17)
        f_setRow(0, "PLUTUS", "P02.2 Deviation")
        f_setRow(1, "Timezone", sessionTz)
        f_setRow(2, "Reference", referenceMode)
        f_setRow(3, "Active Session", activeSessionName)
        f_setRow(4, "Reference VWAP", not na(valueRef) ? str.tostring(valueRef, format.mintick) : "N/A")
        f_setRow(5, "Band Basis", bandBasis)
        f_setRow(6, "Band Unit", not na(bandUnit) ? str.tostring(bandUnit, format.mintick) : "N/A")
        f_setRow(7, "Normalized Dist", not na(normalizedDistance) ? str.tostring(normalizedDistance, "#.##") : "N/A")
        f_setRow(8, "Slope / ATR", not na(slopeAtr) ? str.tostring(slopeAtr, "#.###") : "N/A")
        f_setRow(9, "Slope", valueRising ? "RISING" : valueFalling ? "FALLING" : valueFlat ? "FLAT" : "N/A")
        f_setRow(10, "Accepted Above", acceptedAbove ? "YES" : "NO")
        f_setRow(11, "Accepted Below", acceptedBelow ? "YES" : "NO")
        f_setRow(12, "Equilibrium", equilibrium ? "YES" : "NO")
        f_setRow(13, "Band State", bandState)
        f_setRow(14, "Mean Reversion", meanReversionContext ? "YES" : "NO")
        f_setRow(15, "Value State", valueState)
        f_setRow(16, "Ref Reset", refReset ? "YES" : "NO")
        f_setRow(17, "Confirmed Bar", barstate.isconfirmed ? "YES" : "NO")
    else
        table.clear(diag, 0, 0, 1, 17)
