//@version=6
indicator("PLUTUS P03.1 — Volume Profile Value Area", shorttitle="PLUTUS P03.1", overlay=true, max_labels_count=50)

//==============================================================================
// PLUTUS P03.1 — POC / VAH / VAL Extraction
// Builds on P03.0 while preserving the same bounded single-price-per-bar volume
// allocation model. Adds a POC-centered value-area algorithm and completed-
// profile carryover.
//==============================================================================

//------------------------------------------------------------------------------
// Inputs
//------------------------------------------------------------------------------
groupTiming = "Timing / Timezone"
timezoneInput = input.string("Exchange", "Session Timezone", options=["Exchange", "UTC-2", "UTC-1", "UTC+0", "UTC+1", "UTC+2", "America/New_York", "Europe/London", "Asia/Tokyo"], group=groupTiming)
string sessionTz = timezoneInput == "Exchange" ? syminfo.timezone : timezoneInput

groupProfile = "Profile Engine"
profileScope = input.string("New York", "Profile Scope", options=["Asia", "London", "New York", "Day"], group=groupProfile)
allocationSource = input.source(hlc3, "Allocation Price", group=groupProfile)
binCount = input.int(24, "Price Bins", minval=8, maxval=80, group=groupProfile)
maxProfileBars = input.int(300, "Maximum Bars Per Profile", minval=25, maxval=1000, group=groupProfile)
valueAreaPct = input.float(70.0, "Value Area %", minval=50.0, maxval=99.0, step=1.0, group=groupProfile)

groupDisplay = "Display"
showDevelopingLevels = input.bool(true, "Show Developing POC / VAH / VAL", group=groupDisplay)
showCompletedLevels = input.bool(false, "Show Previous Completed POC / VAH / VAL", group=groupDisplay)
showRange = input.bool(false, "Show Profile High / Low", group=groupDisplay)
showTable = input.bool(true, "Show Diagnostic Table", group=groupDisplay)
lineWidth = input.int(2, "Line Width", minval=1, maxval=4, group=groupDisplay)

//------------------------------------------------------------------------------
// Fixed ARTHA sessions
//------------------------------------------------------------------------------
string asiaSession = "0000-0800:1234567"
string londonSession = "0800-1630:1234567"
string newYorkSession = "1330-2000:1234567"

bool inAsia = not na(time(timeframe.period, asiaSession, sessionTz))
bool inLondon = not na(time(timeframe.period, londonSession, sessionTz))
bool inNewYork = not na(time(timeframe.period, newYorkSession, sessionTz))

bool newAsia = inAsia and not inAsia[1]
bool newLondon = inLondon and not inLondon[1]
bool newNewYork = inNewYork and not inNewYork[1]

int localDay = dayofmonth(time, sessionTz)
bool newDay = ta.change(localDay) != 0

bool scopeActive = switch profileScope
    "Asia" => inAsia
    "London" => inLondon
    "New York" => inNewYork
    => true

bool scopeReset = switch profileScope
    "Asia" => newAsia
    "London" => newLondon
    "New York" => newNewYork
    => barstate.isfirst or newDay

//------------------------------------------------------------------------------
// Bounded profile storage
//------------------------------------------------------------------------------
var array<float> profilePrices = array.new_float()
var array<float> profileHighs = array.new_float()
var array<float> profileLows = array.new_float()
var array<float> profileVolumes = array.new_float()
var array<float> bins = array.new_float()

if barstate.isfirst
    for i = 0 to binCount - 1
        array.push(bins, 0.0)

//------------------------------------------------------------------------------
// Previous completed profile snapshot
// Capture the final values from the prior profile before storage resets.
//------------------------------------------------------------------------------
var float completedPoc = na
var float completedVah = na
var float completedVal = na
var float completedHigh = na
var float completedLow = na

//------------------------------------------------------------------------------
// Rebuild outputs are declared before reset snapshot so prior-bar values are
// available through history referencing on the next reset bar.
//------------------------------------------------------------------------------
float profileHigh = na
float profileLow = na
float pocPrice = na
float pocVolume = na
float vahPrice = na
float valPrice = na
float totalProfileVolume = 0.0
float valueAreaVolume = 0.0
float binSize = na
int pocIndex = na
int vaLowIndex = na
int vaHighIndex = na

if scopeReset and not barstate.isfirst
    completedPoc := pocPrice[1]
    completedVah := vahPrice[1]
    completedVal := valPrice[1]
    completedHigh := profileHigh[1]
    completedLow := profileLow[1]

if scopeReset
    array.clear(profilePrices)
    array.clear(profileHighs)
    array.clear(profileLows)
    array.clear(profileVolumes)

if scopeActive and not na(volume)
    array.push(profilePrices, allocationSource)
    array.push(profileHighs, high)
    array.push(profileLows, low)
    array.push(profileVolumes, volume)

    if array.size(profilePrices) > maxProfileBars
        array.shift(profilePrices)
        array.shift(profileHighs)
        array.shift(profileLows)
        array.shift(profileVolumes)

//------------------------------------------------------------------------------
// Rebuild current profile from stored bars
//------------------------------------------------------------------------------
int storedBars = array.size(profilePrices)

if storedBars > 0
    profileHigh := array.max(profileHighs)
    profileLow := array.min(profileLows)

    float profileRange = profileHigh - profileLow
    binSize := profileRange > 0.0 ? profileRange / binCount : syminfo.mintick
    binSize := math.max(binSize, syminfo.mintick)

    for i = 0 to binCount - 1
        array.set(bins, i, 0.0)

    for i = 0 to storedBars - 1
        float p = array.get(profilePrices, i)
        float v = array.get(profileVolumes, i)
        int idx = int(math.floor((p - profileLow) / binSize))
        idx := math.max(0, math.min(binCount - 1, idx))
        array.set(bins, idx, array.get(bins, idx) + v)
        totalProfileVolume += v

    float maxBinVol = -1.0
    pocIndex := 0
    for i = 0 to binCount - 1
        float binVol = array.get(bins, i)
        if binVol > maxBinVol
            maxBinVol := binVol
            pocIndex := i

    pocVolume := maxBinVol
    pocPrice := profileLow + (pocIndex + 0.5) * binSize

    // POC-centered value-area expansion.
    // At each step, include the adjacent side with the larger volume. Ties expand
    // both sides when available. Continue until the target share is reached.
    float targetVolume = totalProfileVolume * valueAreaPct / 100.0
    vaLowIndex := pocIndex
    vaHighIndex := pocIndex
    valueAreaVolume := array.get(bins, pocIndex)

    int expansionSteps = 0
    while valueAreaVolume < targetVolume and expansionSteps < binCount
        bool canDown = vaLowIndex > 0
        bool canUp = vaHighIndex < binCount - 1

        if not canDown and not canUp
            break

        float downVol = canDown ? array.get(bins, vaLowIndex - 1) : -1.0
        float upVol = canUp ? array.get(bins, vaHighIndex + 1) : -1.0

        if canDown and canUp and downVol == upVol
            vaLowIndex -= 1
            vaHighIndex += 1
            valueAreaVolume += downVol + upVol
        else if canUp and (not canDown or upVol > downVol)
            vaHighIndex += 1
            valueAreaVolume += upVol
        else if canDown
            vaLowIndex -= 1
            valueAreaVolume += downVol

        expansionSteps += 1

    valPrice := profileLow + vaLowIndex * binSize
    vahPrice := profileLow + (vaHighIndex + 1) * binSize

//------------------------------------------------------------------------------
// Auction-location classification
//------------------------------------------------------------------------------
string priceLocation = "UNAVAILABLE"
if not na(pocPrice) and not na(vahPrice) and not na(valPrice)
    if close > vahPrice
        priceLocation := "ABOVE_VALUE"
    else if close < valPrice
        priceLocation := "BELOW_VALUE"
    else if close > pocPrice
        priceLocation := "UPPER_VALUE"
    else if close < pocPrice
        priceLocation := "LOWER_VALUE"
    else
        priceLocation := "AT_POC"

//------------------------------------------------------------------------------
// Plots
//------------------------------------------------------------------------------
float developingPocPlot = showDevelopingLevels and scopeActive ? pocPrice : na
float developingVahPlot = showDevelopingLevels and scopeActive ? vahPrice : na
float developingValPlot = showDevelopingLevels and scopeActive ? valPrice : na
float highPlot = showRange and scopeActive ? profileHigh : na
float lowPlot = showRange and scopeActive ? profileLow : na

developingPocPlot := scopeReset ? na : developingPocPlot
developingVahPlot := scopeReset ? na : developingVahPlot
developingValPlot := scopeReset ? na : developingValPlot
highPlot := scopeReset ? na : highPlot
lowPlot := scopeReset ? na : lowPlot

plot(developingPocPlot, "Developing POC", color=color.orange, linewidth=lineWidth, style=plot.style_linebr)
plot(developingVahPlot, "Developing VAH", color=color.new(color.green, 10), linewidth=1, style=plot.style_linebr)
plot(developingValPlot, "Developing VAL", color=color.new(color.red, 10), linewidth=1, style=plot.style_linebr)
plot(highPlot, "Profile High", color=color.new(color.gray, 35), linewidth=1, style=plot.style_linebr)
plot(lowPlot, "Profile Low", color=color.new(color.gray, 35), linewidth=1, style=plot.style_linebr)

plot(showCompletedLevels ? completedPoc : na, "Previous Completed POC", color=color.new(color.orange, 55), linewidth=1, style=plot.style_linebr)
plot(showCompletedLevels ? completedVah : na, "Previous Completed VAH", color=color.new(color.green, 65), linewidth=1, style=plot.style_linebr)
plot(showCompletedLevels ? completedVal : na, "Previous Completed VAL", color=color.new(color.red, 65), linewidth=1, style=plot.style_linebr)

//------------------------------------------------------------------------------
// Diagnostics
//------------------------------------------------------------------------------
float pocShare = not na(pocVolume) and totalProfileVolume > 0.0 ? pocVolume / totalProfileVolume : na
float achievedValueAreaPct = totalProfileVolume > 0.0 ? valueAreaVolume / totalProfileVolume * 100.0 : na
string scopeState = scopeActive ? "ACTIVE" : "CLOSED"
string volumeState = na(volume) ? "UNAVAILABLE" : "AVAILABLE"

var table diag = table.new(position.top_right, 2, 18, border_width=1, frame_width=1, bgcolor=color.new(color.black, 15))

f_setRow(int row, string labelText, string valueText) =>
    table.cell(diag, 0, row, labelText, text_color=color.silver, bgcolor=color.new(color.black, 15), text_halign=text.align_left)
    table.cell(diag, 1, row, valueText, text_color=color.white, bgcolor=color.new(color.black, 15), text_halign=text.align_right)

if barstate.islast
    if showTable
        table.clear(diag, 0, 0, 1, 17)
        f_setRow(0, "PLUTUS", "P03.1 Value Area")
        f_setRow(1, "Timezone", sessionTz)
        f_setRow(2, "Scope", profileScope)
        f_setRow(3, "Scope State", scopeState)
        f_setRow(4, "Volume", volumeState)
        f_setRow(5, "Stored Bars", str.tostring(storedBars))
        f_setRow(6, "Bins", str.tostring(binCount))
        f_setRow(7, "Value Area Target", str.tostring(valueAreaPct, "#.0") + "%")
        f_setRow(8, "Value Area Achieved", not na(achievedValueAreaPct) ? str.tostring(achievedValueAreaPct, "#.1") + "%" : "N/A")
        f_setRow(9, "Profile High", not na(profileHigh) ? str.tostring(profileHigh, format.mintick) : "N/A")
        f_setRow(10, "VAH", not na(vahPrice) ? str.tostring(vahPrice, format.mintick) : "N/A")
        f_setRow(11, "POC", not na(pocPrice) ? str.tostring(pocPrice, format.mintick) : "N/A")
        f_setRow(12, "VAL", not na(valPrice) ? str.tostring(valPrice, format.mintick) : "N/A")
        f_setRow(13, "Profile Low", not na(profileLow) ? str.tostring(profileLow, format.mintick) : "N/A")
        f_setRow(14, "POC Volume %", not na(pocShare) ? str.tostring(pocShare * 100.0, "#.0") + "%" : "N/A")
        f_setRow(15, "Price Location", priceLocation)
        f_setRow(16, "Previous POC", not na(completedPoc) ? str.tostring(completedPoc, format.mintick) : "N/A")
        f_setRow(17, "Profile Volume", totalProfileVolume > 0.0 ? str.tostring(totalProfileVolume, format.volume) : "N/A")
    else
        table.clear(diag, 0, 0, 1, 17)
