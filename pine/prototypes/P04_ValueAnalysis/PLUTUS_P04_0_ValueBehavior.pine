//@version=6
indicator("PLUTUS P04.0 — Value Behavior", shorttitle="PLUTUS P04.0", overlay=true, max_labels_count=50)

//==============================================================================
// PLUTUS P04.0 — Value Behavior Baseline
// Interprets auction behavior around developing profile value.
// Context only: acceptance, rejection, failed acceptance, rotation, directional
// auction, and balance/imbalance. No trade signals.
//==============================================================================

groupTiming = "Timing / Timezone"
timezoneInput = input.string("Exchange", "Session Timezone", options=["Exchange", "UTC-2", "UTC-1", "UTC+0", "UTC+1", "UTC+2", "America/New_York", "Europe/London", "Asia/Tokyo"], group=groupTiming)
string sessionTz = timezoneInput == "Exchange" ? syminfo.timezone : timezoneInput

groupProfile = "Profile Engine"
profileScope = input.string("New York", "Profile Scope", options=["Asia", "London", "New York", "Day"], group=groupProfile)
allocationSource = input.source(hlc3, "Allocation Price", group=groupProfile)
binCount = input.int(24, "Price Bins", minval=8, maxval=80, group=groupProfile)
maxProfileBars = input.int(300, "Maximum Bars Per Profile", minval=25, maxval=1000, group=groupProfile)
valueAreaPct = input.float(70.0, "Value Area %", minval=50.0, maxval=99.0, step=1.0, group=groupProfile)

groupModel = "Value Behavior Model"
acceptanceLookback = input.int(5, "Acceptance Lookback", minval=2, maxval=30, group=groupModel)
acceptanceRatioMin = input.float(0.70, "Acceptance Ratio", minval=0.50, maxval=1.00, step=0.05, group=groupModel)
rejectionLookback = input.int(3, "Rejection Lookback", minval=1, maxval=10, group=groupModel)
rotationLookback = input.int(10, "POC Rotation Lookback", minval=3, maxval=50, group=groupModel)
minPocCrosses = input.int(3, "Minimum POC Crosses", minval=1, maxval=20, group=groupModel)
atrLen = input.int(14, "ATR Length", minval=1, group=groupModel)
imbalanceDistanceAtr = input.float(0.50, "Directional Auction Distance / ATR", minval=0.10, step=0.05, group=groupModel)

groupDisplay = "Display"
showValueLevels = input.bool(true, "Show Developing POC / VAH / VAL", group=groupDisplay)
showTable = input.bool(true, "Show Diagnostic Table", group=groupDisplay)
lineWidth = input.int(2, "Line Width", minval=1, maxval=4, group=groupDisplay)

string asiaSession = "0000-0800:1234567"
string londonSession = "0800-1630:1234567"
string newYorkSession = "1330-2000:1234567"

bool inAsia = not na(time(timeframe.period, asiaSession, sessionTz))
bool inLondon = not na(time(timeframe.period, londonSession, sessionTz))
bool inNewYork = not na(time(timeframe.period, newYorkSession, sessionTz))
bool newAsia = inAsia and not inAsia[1]
bool newLondon = inLondon and not inLondon[1]
bool newNewYork = inNewYork and not inNewYork[1]
int localDay = dayofmonth(time, sessionTz)
bool newDay = ta.change(localDay) != 0

bool scopeActive = switch profileScope
    "Asia" => inAsia
    "London" => inLondon
    "New York" => inNewYork
    => true

bool scopeReset = switch profileScope
    "Asia" => newAsia
    "London" => newLondon
    "New York" => newNewYork
    => barstate.isfirst or newDay

var array<float> profilePrices = array.new_float()
var array<float> profileHighs = array.new_float()
var array<float> profileLows = array.new_float()
var array<float> profileVolumes = array.new_float()
var array<float> bins = array.new_float()

if barstate.isfirst
    for i = 0 to binCount - 1
        array.push(bins, 0.0)

if scopeReset
    array.clear(profilePrices)
    array.clear(profileHighs)
    array.clear(profileLows)
    array.clear(profileVolumes)

if scopeActive and not na(volume)
    array.push(profilePrices, allocationSource)
    array.push(profileHighs, high)
    array.push(profileLows, low)
    array.push(profileVolumes, volume)
    if array.size(profilePrices) > maxProfileBars
        array.shift(profilePrices)
        array.shift(profileHighs)
        array.shift(profileLows)
        array.shift(profileVolumes)

float profileHigh = na
float profileLow = na
float pocPrice = na
float vahPrice = na
float valPrice = na
float totalProfileVolume = 0.0
float valueAreaVolume = 0.0
float binSize = na
int pocIndex = na
int vaLowIndex = na
int vaHighIndex = na
int storedBars = array.size(profilePrices)

if storedBars > 0
    profileHigh := array.max(profileHighs)
    profileLow := array.min(profileLows)
    float profileRange = profileHigh - profileLow
    binSize := math.max(profileRange > 0.0 ? profileRange / binCount : syminfo.mintick, syminfo.mintick)

    for i = 0 to binCount - 1
        array.set(bins, i, 0.0)

    for i = 0 to storedBars - 1
        float p = array.get(profilePrices, i)
        float v = array.get(profileVolumes, i)
        int idx = int(math.floor((p - profileLow) / binSize))
        idx := math.max(0, math.min(binCount - 1, idx))
        array.set(bins, idx, array.get(bins, idx) + v)
        totalProfileVolume += v

    float maxBinVol = -1.0
    pocIndex := 0
    for i = 0 to binCount - 1
        float binVol = array.get(bins, i)
        if binVol > maxBinVol
            maxBinVol := binVol
            pocIndex := i

    pocPrice := profileLow + (pocIndex + 0.5) * binSize
    float targetVolume = totalProfileVolume * valueAreaPct / 100.0
    vaLowIndex := pocIndex
    vaHighIndex := pocIndex
    valueAreaVolume := array.get(bins, pocIndex)
    int expansionSteps = 0
    while valueAreaVolume < targetVolume and expansionSteps < binCount
        bool canDown = vaLowIndex > 0
        bool canUp = vaHighIndex < binCount - 1
        if not canDown and not canUp
            break
        float downVol = canDown ? array.get(bins, vaLowIndex - 1) : -1.0
        float upVol = canUp ? array.get(bins, vaHighIndex + 1) : -1.0
        if canDown and canUp and downVol == upVol
            vaLowIndex -= 1
            vaHighIndex += 1
            valueAreaVolume += downVol + upVol
        else if canUp and (not canDown or upVol > downVol)
            vaHighIndex += 1
            valueAreaVolume += upVol
        else if canDown
            vaLowIndex -= 1
            valueAreaVolume += downVol
        expansionSteps += 1

    valPrice := profileLow + vaLowIndex * binSize
    vahPrice := profileLow + (vaHighIndex + 1) * binSize

float atr = ta.atr(atrLen)
bool valueReady = scopeActive and not na(pocPrice) and not na(vahPrice) and not na(valPrice)

float aboveRatio = ta.sma(valueReady and close > vahPrice ? 1.0 : 0.0, acceptanceLookback)
float belowRatio = ta.sma(valueReady and close < valPrice ? 1.0 : 0.0, acceptanceLookback)
float insideRatio = ta.sma(valueReady and close <= vahPrice and close >= valPrice ? 1.0 : 0.0, acceptanceLookback)

bool acceptedAbove = valueReady and not na(aboveRatio) and aboveRatio >= acceptanceRatioMin
bool acceptedBelow = valueReady and not na(belowRatio) and belowRatio >= acceptanceRatioMin
bool acceptedInside = valueReady and not na(insideRatio) and insideRatio >= acceptanceRatioMin

bool recentlyAbove = ta.highest(valueReady and close > vahPrice ? 1.0 : 0.0, rejectionLookback) > 0
bool recentlyBelow = ta.highest(valueReady and close < valPrice ? 1.0 : 0.0, rejectionLookback) > 0
bool rejectedFromAbove = valueReady and recentlyAbove and close < vahPrice and close >= valPrice
bool rejectedFromBelow = valueReady and recentlyBelow and close > valPrice and close <= vahPrice

bool failedAcceptanceAbove = acceptedAbove[1] and valueReady and close < vahPrice
bool failedAcceptanceBelow = acceptedBelow[1] and valueReady and close > valPrice

bool pocCross = valueReady and not na(pocPrice[1]) and ((close > pocPrice and close[1] <= pocPrice[1]) or (close < pocPrice and close[1] >= pocPrice[1]))
float pocCrossRate = ta.sma(pocCross ? 1.0 : 0.0, rotationLookback)
float approximatePocCrosses = not na(pocCrossRate) ? pocCrossRate * rotationLookback : na
bool rotatingAtPoc = valueReady and not na(approximatePocCrosses) and approximatePocCrosses >= minPocCrosses and acceptedInside

float distanceFromPocAtr = valueReady and not na(atr) and atr > 0.0 ? (close - pocPrice) / atr : na
bool directionalUp = acceptedAbove and not na(distanceFromPocAtr) and distanceFromPocAtr >= imbalanceDistanceAtr
bool directionalDown = acceptedBelow and not na(distanceFromPocAtr) and distanceFromPocAtr <= -imbalanceDistanceAtr

string candidateState = "VALUE_BALANCED"
if not valueReady
    candidateState := "VALUE_UNAVAILABLE"
else if failedAcceptanceAbove
    candidateState := "FAILED_ACCEPTANCE_ABOVE"
else if failedAcceptanceBelow
    candidateState := "FAILED_ACCEPTANCE_BELOW"
else if rejectedFromAbove
    candidateState := "REJECTION_FROM_ABOVE_VALUE"
else if rejectedFromBelow
    candidateState := "REJECTION_FROM_BELOW_VALUE"
else if directionalUp
    candidateState := "DIRECTIONAL_AUCTION_HIGHER"
else if directionalDown
    candidateState := "DIRECTIONAL_AUCTION_LOWER"
else if acceptedAbove
    candidateState := "ACCEPTANCE_ABOVE_VALUE"
else if acceptedBelow
    candidateState := "ACCEPTANCE_BELOW_VALUE"
else if rotatingAtPoc
    candidateState := "ROTATION_AROUND_POC"
else if acceptedInside
    candidateState := "ACCEPTANCE_INSIDE_VALUE"
else
    candidateState := "VALUE_TRANSITION"

string state = barstate.isconfirmed ? candidateState : "FORMING"

float pocPlot = showValueLevels and scopeActive ? pocPrice : na
float vahPlot = showValueLevels and scopeActive ? vahPrice : na
float valPlot = showValueLevels and scopeActive ? valPrice : na
pocPlot := scopeReset ? na : pocPlot
vahPlot := scopeReset ? na : vahPlot
valPlot := scopeReset ? na : valPlot

plot(pocPlot, "Developing POC", color=color.orange, linewidth=lineWidth, style=plot.style_linebr)
plot(vahPlot, "Developing VAH", color=color.new(color.green, 10), linewidth=1, style=plot.style_linebr)
plot(valPlot, "Developing VAL", color=color.new(color.red, 10), linewidth=1, style=plot.style_linebr)

var table diag = table.new(position.top_right, 2, 17, border_width=1, frame_width=1, bgcolor=color.new(color.black, 15))
f_setRow(int row, string labelText, string valueText) =>
    table.cell(diag, 0, row, labelText, text_color=color.silver, bgcolor=color.new(color.black, 15), text_halign=text.align_left)
    table.cell(diag, 1, row, valueText, text_color=color.white, bgcolor=color.new(color.black, 15), text_halign=text.align_right)

if barstate.islast
    if showTable
        table.clear(diag, 0, 0, 1, 16)
        f_setRow(0, "PLUTUS", "P04.0 Value Behavior")
        f_setRow(1, "Timezone", sessionTz)
        f_setRow(2, "Scope", profileScope)
        f_setRow(3, "Scope State", scopeActive ? "ACTIVE" : "CLOSED")
        f_setRow(4, "Stored Bars", str.tostring(storedBars))
        f_setRow(5, "VAH", not na(vahPrice) ? str.tostring(vahPrice, format.mintick) : "N/A")
        f_setRow(6, "POC", not na(pocPrice) ? str.tostring(pocPrice, format.mintick) : "N/A")
        f_setRow(7, "VAL", not na(valPrice) ? str.tostring(valPrice, format.mintick) : "N/A")
        f_setRow(8, "Above Acceptance", not na(aboveRatio) ? str.tostring(aboveRatio * 100.0, "#.0") + "%" : "N/A")
        f_setRow(9, "Inside Acceptance", not na(insideRatio) ? str.tostring(insideRatio * 100.0, "#.0") + "%" : "N/A")
        f_setRow(10, "Below Acceptance", not na(belowRatio) ? str.tostring(belowRatio * 100.0, "#.0") + "%" : "N/A")
        f_setRow(11, "POC Crosses", not na(approximatePocCrosses) ? str.tostring(approximatePocCrosses, "#.0") : "N/A")
        f_setRow(12, "Distance / ATR", not na(distanceFromPocAtr) ? str.tostring(distanceFromPocAtr, "#.###") : "N/A")
        f_setRow(13, "Reject Above", rejectedFromAbove ? "YES" : "NO")
        f_setRow(14, "Reject Below", rejectedFromBelow ? "YES" : "NO")
        f_setRow(15, "Confirmed", barstate.isconfirmed ? "YES" : "NO")
        f_setRow(16, "State", state)
    else
        table.clear(diag, 0, 0, 1, 16)
