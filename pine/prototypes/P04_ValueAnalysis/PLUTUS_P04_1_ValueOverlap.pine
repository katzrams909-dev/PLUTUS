//@version=6
indicator("PLUTUS P04.1 — Value Overlap / Separation", shorttitle="PLUTUS P04.1", overlay=true, max_labels_count=50)

//==============================================================================
// PLUTUS P04.1 — Value Overlap / Separation
// Builds on P04.0 profile/value mechanics and compares the current developing
// value area against the previous completed value area.
// Context only; no trade signals.
//==============================================================================

//------------------------------------------------------------------------------
// Inputs
//------------------------------------------------------------------------------
groupTiming = "Timing / Timezone"
timezoneInput = input.string("Exchange", "Session Timezone", options=["Exchange", "UTC-2", "UTC-1", "UTC+0", "UTC+1", "UTC+2", "America/New_York", "Europe/London", "Asia/Tokyo"], group=groupTiming)
string sessionTz = timezoneInput == "Exchange" ? syminfo.timezone : timezoneInput

groupProfile = "Profile Engine"
profileScope = input.string("New York", "Profile Scope", options=["Asia", "London", "New York", "Day"], group=groupProfile)
allocationSource = input.source(hlc3, "Allocation Price", group=groupProfile)
binCount = input.int(24, "Price Bins", minval=8, maxval=80, group=groupProfile)
maxProfileBars = input.int(300, "Maximum Bars Per Profile", minval=25, maxval=1000, group=groupProfile)
valueAreaPct = input.float(70.0, "Value Area %", minval=50.0, maxval=99.0, step=1.0, group=groupProfile)

groupRelationship = "Value Relationship Model"
atrLen = input.int(14, "ATR Length", minval=1, group=groupRelationship)
minShiftPct = input.float(10.0, "Minimum Midpoint Shift / Previous VA Width %", minval=0.0, maxval=100.0, step=5.0, group=groupRelationship)
strongSeparationAtr = input.float(0.25, "Strong Separation Gap / ATR", minval=0.0, step=0.05, group=groupRelationship)

groupDisplay = "Display"
showCurrentLevels = input.bool(true, "Show Current POC / VAH / VAL", group=groupDisplay)
showPreviousLevels = input.bool(false, "Show Previous Completed POC / VAH / VAL", group=groupDisplay)
showTable = input.bool(true, "Show Diagnostic Table", group=groupDisplay)
lineWidth = input.int(2, "Line Width", minval=1, maxval=4, group=groupDisplay)

//------------------------------------------------------------------------------
// Helpers
//------------------------------------------------------------------------------
f_clamp(float x, float lo, float hi) =>
    math.max(lo, math.min(hi, x))

//------------------------------------------------------------------------------
// Fixed ARTHA sessions
//------------------------------------------------------------------------------
string asiaSession = "0000-0800:1234567"
string londonSession = "0800-1630:1234567"
string newYorkSession = "1330-2000:1234567"

bool inAsia = not na(time(timeframe.period, asiaSession, sessionTz))
bool inLondon = not na(time(timeframe.period, londonSession, sessionTz))
bool inNewYork = not na(time(timeframe.period, newYorkSession, sessionTz))

bool newAsia = inAsia and not inAsia[1]
bool newLondon = inLondon and not inLondon[1]
bool newNewYork = inNewYork and not inNewYork[1]

int localDay = dayofmonth(time, sessionTz)
bool newDay = ta.change(localDay) != 0

bool scopeActive = switch profileScope
    "Asia" => inAsia
    "London" => inLondon
    "New York" => inNewYork
    => true

bool scopeReset = switch profileScope
    "Asia" => newAsia
    "London" => newLondon
    "New York" => newNewYork
    => barstate.isfirst or newDay

//------------------------------------------------------------------------------
// Profile storage
//------------------------------------------------------------------------------
var array<float> profilePrices = array.new_float()
var array<float> profileHighs = array.new_float()
var array<float> profileLows = array.new_float()
var array<float> profileVolumes = array.new_float()
var array<float> bins = array.new_float()

if barstate.isfirst
    for i = 0 to binCount - 1
        array.push(bins, 0.0)

//------------------------------------------------------------------------------
// Current profile outputs are declared before completed-profile snapshot so the
// previous bar's final developing values can be captured on the reset bar.
//------------------------------------------------------------------------------
float profileHigh = na
float profileLow = na
float pocPrice = na
float vahPrice = na
float valPrice = na
float totalProfileVolume = 0.0
float valueAreaVolume = 0.0
float binSize = na
int pocIndex = na
int vaLowIndex = na
int vaHighIndex = na

var float completedPoc = na
var float completedVah = na
var float completedVal = na

if scopeReset and not barstate.isfirst
    completedPoc := pocPrice[1]
    completedVah := vahPrice[1]
    completedVal := valPrice[1]

if scopeReset
    array.clear(profilePrices)
    array.clear(profileHighs)
    array.clear(profileLows)
    array.clear(profileVolumes)

if scopeActive and not na(volume)
    array.push(profilePrices, allocationSource)
    array.push(profileHighs, high)
    array.push(profileLows, low)
    array.push(profileVolumes, volume)

    if array.size(profilePrices) > maxProfileBars
        array.shift(profilePrices)
        array.shift(profileHighs)
        array.shift(profileLows)
        array.shift(profileVolumes)

//------------------------------------------------------------------------------
// Rebuild current developing profile
//------------------------------------------------------------------------------
int storedBars = array.size(profilePrices)

if storedBars > 0
    profileHigh := array.max(profileHighs)
    profileLow := array.min(profileLows)

    float profileRange = profileHigh - profileLow
    binSize := math.max(profileRange > 0.0 ? profileRange / binCount : syminfo.mintick, syminfo.mintick)

    for i = 0 to binCount - 1
        array.set(bins, i, 0.0)

    for i = 0 to storedBars - 1
        float p = array.get(profilePrices, i)
        float v = array.get(profileVolumes, i)
        int idx = int(math.floor((p - profileLow) / binSize))
        idx := math.max(0, math.min(binCount - 1, idx))
        array.set(bins, idx, array.get(bins, idx) + v)
        totalProfileVolume += v

    float maxBinVol = -1.0
    pocIndex := 0
    for i = 0 to binCount - 1
        float binVol = array.get(bins, i)
        if binVol > maxBinVol
            maxBinVol := binVol
            pocIndex := i

    pocPrice := profileLow + (pocIndex + 0.5) * binSize

    float targetVolume = totalProfileVolume * valueAreaPct / 100.0
    vaLowIndex := pocIndex
    vaHighIndex := pocIndex
    valueAreaVolume := array.get(bins, pocIndex)

    int expansionSteps = 0
    while valueAreaVolume < targetVolume and expansionSteps < binCount
        bool canDown = vaLowIndex > 0
        bool canUp = vaHighIndex < binCount - 1

        if not canDown and not canUp
            break

        float downVol = canDown ? array.get(bins, vaLowIndex - 1) : -1.0
        float upVol = canUp ? array.get(bins, vaHighIndex + 1) : -1.0

        if canDown and canUp and downVol == upVol
            vaLowIndex -= 1
            vaHighIndex += 1
            valueAreaVolume += downVol + upVol
        else if canUp and (not canDown or upVol > downVol)
            vaHighIndex += 1
            valueAreaVolume += upVol
        else if canDown
            vaLowIndex -= 1
            valueAreaVolume += downVol

        expansionSteps += 1

    valPrice := profileLow + vaLowIndex * binSize
    vahPrice := profileLow + (vaHighIndex + 1) * binSize

//------------------------------------------------------------------------------
// Current vs previous value-area relationship
//------------------------------------------------------------------------------
float atr = ta.atr(atrLen)
bool currentReady = scopeActive and not na(vahPrice) and not na(valPrice) and vahPrice > valPrice
bool previousReady = not na(completedVah) and not na(completedVal) and completedVah > completedVal
bool relationshipReady = currentReady and previousReady

float currentWidth = currentReady ? vahPrice - valPrice : na
float previousWidth = previousReady ? completedVah - completedVal : na
float currentMid = currentReady ? (vahPrice + valPrice) * 0.5 : na
float previousMid = previousReady ? (completedVah + completedVal) * 0.5 : na

float overlapLow = relationshipReady ? math.max(valPrice, completedVal) : na
float overlapHigh = relationshipReady ? math.min(vahPrice, completedVah) : na
float overlapWidth = relationshipReady ? math.max(0.0, overlapHigh - overlapLow) : na
float referenceWidth = relationshipReady ? math.min(currentWidth, previousWidth) : na
float overlapPct = relationshipReady and referenceWidth > 0.0 ? overlapWidth / referenceWidth * 100.0 : na

float midpointShift = relationshipReady ? currentMid - previousMid : na
float midpointShiftPct = relationshipReady and previousWidth > 0.0 ? midpointShift / previousWidth * 100.0 : na
float midpointShiftAtr = relationshipReady and not na(atr) and atr > 0.0 ? midpointShift / atr : na

bool separatedHigher = relationshipReady and valPrice >= completedVah
bool separatedLower = relationshipReady and vahPrice <= completedVal
float separationGap = separatedHigher ? valPrice - completedVah : separatedLower ? completedVal - vahPrice : 0.0
float separationGapAtr = relationshipReady and not na(atr) and atr > 0.0 ? separationGap / atr : na
bool strongSeparatedHigher = separatedHigher and not na(separationGapAtr) and separationGapAtr >= strongSeparationAtr
bool strongSeparatedLower = separatedLower and not na(separationGapAtr) and separationGapAtr >= strongSeparationAtr

bool currentInsidePrevious = relationshipReady and valPrice >= completedVal and vahPrice <= completedVah and not separatedHigher and not separatedLower
bool currentEngulfsPrevious = relationshipReady and valPrice <= completedVal and vahPrice >= completedVah and not separatedHigher and not separatedLower
bool hasOverlap = relationshipReady and overlapWidth > 0.0
bool shiftedHigher = hasOverlap and not na(midpointShiftPct) and midpointShiftPct >= minShiftPct
bool shiftedLower = hasOverlap and not na(midpointShiftPct) and midpointShiftPct <= -minShiftPct

float displacementScore = relationshipReady and previousWidth > 0.0 ? f_clamp(midpointShift / previousWidth * 100.0, -100.0, 100.0) : na
float overlapScore = not na(overlapPct) ? f_clamp(overlapPct, 0.0, 100.0) : na

//------------------------------------------------------------------------------
// Relationship state
//------------------------------------------------------------------------------
string candidateState = "VALUE_RELATIONSHIP_TRANSITION"
if not relationshipReady
    candidateState := "VALUE_RELATIONSHIP_UNAVAILABLE"
else if strongSeparatedHigher
    candidateState := "VALUE_STRONGLY_SEPARATED_HIGHER"
else if strongSeparatedLower
    candidateState := "VALUE_STRONGLY_SEPARATED_LOWER"
else if separatedHigher
    candidateState := "VALUE_SEPARATED_HIGHER"
else if separatedLower
    candidateState := "VALUE_SEPARATED_LOWER"
else if currentInsidePrevious
    candidateState := "VALUE_INSIDE_PREVIOUS"
else if currentEngulfsPrevious
    candidateState := "VALUE_ENGULFS_PREVIOUS"
else if shiftedHigher
    candidateState := "VALUE_OVERLAPPING_HIGHER"
else if shiftedLower
    candidateState := "VALUE_OVERLAPPING_LOWER"
else if hasOverlap
    candidateState := "VALUE_OVERLAPPING"
else
    candidateState := "VALUE_RELATIONSHIP_TRANSITION"

string state = barstate.isconfirmed ? candidateState : "FORMING"

//------------------------------------------------------------------------------
// Plots
//------------------------------------------------------------------------------
float currentPocPlot = showCurrentLevels and scopeActive ? pocPrice : na
float currentVahPlot = showCurrentLevels and scopeActive ? vahPrice : na
float currentValPlot = showCurrentLevels and scopeActive ? valPrice : na

currentPocPlot := scopeReset ? na : currentPocPlot
currentVahPlot := scopeReset ? na : currentVahPlot
currentValPlot := scopeReset ? na : currentValPlot

plot(currentPocPlot, "Current POC", color=color.orange, linewidth=lineWidth, style=plot.style_linebr)
plot(currentVahPlot, "Current VAH", color=color.new(color.green, 10), linewidth=1, style=plot.style_linebr)
plot(currentValPlot, "Current VAL", color=color.new(color.red, 10), linewidth=1, style=plot.style_linebr)

plot(showPreviousLevels ? completedPoc : na, "Previous Completed POC", color=color.new(color.orange, 60), linewidth=1, style=plot.style_linebr)
plot(showPreviousLevels ? completedVah : na, "Previous Completed VAH", color=color.new(color.green, 70), linewidth=1, style=plot.style_linebr)
plot(showPreviousLevels ? completedVal : na, "Previous Completed VAL", color=color.new(color.red, 70), linewidth=1, style=plot.style_linebr)

//------------------------------------------------------------------------------
// Diagnostics
//------------------------------------------------------------------------------
var table diag = table.new(position.top_right, 2, 20, border_width=1, frame_width=1, bgcolor=color.new(color.black, 15))

f_setRow(int row, string labelText, string valueText) =>
    table.cell(diag, 0, row, labelText, text_color=color.silver, bgcolor=color.new(color.black, 15), text_halign=text.align_left)
    table.cell(diag, 1, row, valueText, text_color=color.white, bgcolor=color.new(color.black, 15), text_halign=text.align_right)

if barstate.islast
    if showTable
        table.clear(diag, 0, 0, 1, 19)
        f_setRow(0, "PLUTUS", "P04.1 Value Relationship")
        f_setRow(1, "Timezone", sessionTz)
        f_setRow(2, "Scope", profileScope)
        f_setRow(3, "Scope State", scopeActive ? "ACTIVE" : "CLOSED")
        f_setRow(4, "Stored Bars", str.tostring(storedBars))
        f_setRow(5, "Current VAH", not na(vahPrice) ? str.tostring(vahPrice, format.mintick) : "N/A")
        f_setRow(6, "Current VAL", not na(valPrice) ? str.tostring(valPrice, format.mintick) : "N/A")
        f_setRow(7, "Previous VAH", not na(completedVah) ? str.tostring(completedVah, format.mintick) : "N/A")
        f_setRow(8, "Previous VAL", not na(completedVal) ? str.tostring(completedVal, format.mintick) : "N/A")
        f_setRow(9, "Overlap %", not na(overlapPct) ? str.tostring(overlapPct, "#.1") + "%" : "N/A")
        f_setRow(10, "Mid Shift %", not na(midpointShiftPct) ? str.tostring(midpointShiftPct, "#.1") + "%" : "N/A")
        f_setRow(11, "Mid Shift / ATR", not na(midpointShiftAtr) ? str.tostring(midpointShiftAtr, "#.###") : "N/A")
        f_setRow(12, "Gap / ATR", not na(separationGapAtr) ? str.tostring(separationGapAtr, "#.###") : "N/A")
        f_setRow(13, "Inside Previous", currentInsidePrevious ? "YES" : "NO")
        f_setRow(14, "Engulfs Previous", currentEngulfsPrevious ? "YES" : "NO")
        f_setRow(15, "Separated Higher", separatedHigher ? "YES" : "NO")
        f_setRow(16, "Separated Lower", separatedLower ? "YES" : "NO")
        f_setRow(17, "Overlap Score", not na(overlapScore) ? str.tostring(overlapScore, "#.1") : "N/A")
        f_setRow(18, "Displacement Score", not na(displacementScore) ? str.tostring(displacementScore, "#.1") : "N/A")
        f_setRow(19, "State", state)
    else
        table.clear(diag, 0, 0, 1, 19)
