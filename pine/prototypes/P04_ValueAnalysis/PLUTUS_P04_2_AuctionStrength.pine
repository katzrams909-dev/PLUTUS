//@version=6
indicator("PLUTUS P04.2 — Auction Strength", shorttitle="PLUTUS P04.2", overlay=true, max_labels_count=50)

//==============================================================================
// PLUTUS P04.2 — Auction Acceptance / Rejection Strength
// Quantifies P04.0/P04.1 auction behavior with bounded, auditable scores.
// Context only; no trade signals.
//==============================================================================

groupTiming = "Timing / Timezone"
timezoneInput = input.string("Exchange", "Session Timezone", options=["Exchange", "UTC-2", "UTC-1", "UTC+0", "UTC+1", "UTC+2", "America/New_York", "Europe/London", "Asia/Tokyo"], group=groupTiming)
string sessionTz = timezoneInput == "Exchange" ? syminfo.timezone : timezoneInput

groupProfile = "Profile Engine"
profileScope = input.string("New York", "Profile Scope", options=["Asia", "London", "New York", "Day"], group=groupProfile)
allocationSource = input.source(hlc3, "Allocation Price", group=groupProfile)
binCount = input.int(24, "Price Bins", minval=8, maxval=80, group=groupProfile)
maxProfileBars = input.int(300, "Maximum Bars Per Profile", minval=25, maxval=1000, group=groupProfile)
valueAreaPct = input.float(70.0, "Value Area %", minval=50.0, maxval=99.0, step=1.0, group=groupProfile)

groupModel = "Auction Strength Model"
acceptanceLookback = input.int(5, "Acceptance Lookback", minval=2, maxval=30, group=groupModel)
rejectionLookback = input.int(3, "Rejection Lookback", minval=1, maxval=10, group=groupModel)
rotationLookback = input.int(10, "POC Rotation Lookback", minval=3, maxval=50, group=groupModel)
atrLen = input.int(14, "ATR Length", minval=1, group=groupModel)
strongDistanceAtr = input.float(1.0, "Full Directional Strength Distance / ATR", minval=0.10, step=0.10, group=groupModel)
maxRejectExcursionAtr = input.float(1.0, "Full Rejection Excursion / ATR", minval=0.10, step=0.10, group=groupModel)

groupDisplay = "Display"
showValueLevels = input.bool(true, "Show Current POC / VAH / VAL", group=groupDisplay)
showPreviousLevels = input.bool(false, "Show Previous Completed VAH / VAL", group=groupDisplay)
showTable = input.bool(true, "Show Diagnostic Table", group=groupDisplay)
lineWidth = input.int(2, "Line Width", minval=1, maxval=4, group=groupDisplay)

f_clamp(float x, float lo, float hi) =>
    math.max(lo, math.min(hi, x))

string asiaSession = "0000-0800:1234567"
string londonSession = "0800-1630:1234567"
string newYorkSession = "1330-2000:1234567"

bool inAsia = not na(time(timeframe.period, asiaSession, sessionTz))
bool inLondon = not na(time(timeframe.period, londonSession, sessionTz))
bool inNewYork = not na(time(timeframe.period, newYorkSession, sessionTz))
bool newAsia = inAsia and not inAsia[1]
bool newLondon = inLondon and not inLondon[1]
bool newNewYork = inNewYork and not inNewYork[1]
int localDay = dayofmonth(time, sessionTz)
bool newDay = ta.change(localDay) != 0

bool scopeActive = switch profileScope
    "Asia" => inAsia
    "London" => inLondon
    "New York" => inNewYork
    => true

bool scopeReset = switch profileScope
    "Asia" => newAsia
    "London" => newLondon
    "New York" => newNewYork
    => barstate.isfirst or newDay

var array<float> profilePrices = array.new_float()
var array<float> profileHighs = array.new_float()
var array<float> profileLows = array.new_float()
var array<float> profileVolumes = array.new_float()
var array<float> bins = array.new_float()

if barstate.isfirst
    for i = 0 to binCount - 1
        array.push(bins, 0.0)

float profileHigh = na
float profileLow = na
float pocPrice = na
float vahPrice = na
float valPrice = na
float totalProfileVolume = 0.0
float valueAreaVolume = 0.0
float binSize = na
int pocIndex = na
int vaLowIndex = na
int vaHighIndex = na

var float completedVah = na
var float completedVal = na
var float completedPoc = na

if scopeReset and not barstate.isfirst
    completedVah := vahPrice[1]
    completedVal := valPrice[1]
    completedPoc := pocPrice[1]

if scopeReset
    array.clear(profilePrices)
    array.clear(profileHighs)
    array.clear(profileLows)
    array.clear(profileVolumes)

if scopeActive and not na(volume)
    array.push(profilePrices, allocationSource)
    array.push(profileHighs, high)
    array.push(profileLows, low)
    array.push(profileVolumes, volume)
    if array.size(profilePrices) > maxProfileBars
        array.shift(profilePrices)
        array.shift(profileHighs)
        array.shift(profileLows)
        array.shift(profileVolumes)

int storedBars = array.size(profilePrices)
if storedBars > 0
    profileHigh := array.max(profileHighs)
    profileLow := array.min(profileLows)
    float profileRange = profileHigh - profileLow
    binSize := math.max(profileRange > 0.0 ? profileRange / binCount : syminfo.mintick, syminfo.mintick)

    for i = 0 to binCount - 1
        array.set(bins, i, 0.0)

    for i = 0 to storedBars - 1
        float p = array.get(profilePrices, i)
        float v = array.get(profileVolumes, i)
        int idx = int(math.floor((p - profileLow) / binSize))
        idx := math.max(0, math.min(binCount - 1, idx))
        array.set(bins, idx, array.get(bins, idx) + v)
        totalProfileVolume += v

    float maxBinVol = -1.0
    pocIndex := 0
    for i = 0 to binCount - 1
        float binVol = array.get(bins, i)
        if binVol > maxBinVol
            maxBinVol := binVol
            pocIndex := i

    pocPrice := profileLow + (pocIndex + 0.5) * binSize
    float targetVolume = totalProfileVolume * valueAreaPct / 100.0
    vaLowIndex := pocIndex
    vaHighIndex := pocIndex
    valueAreaVolume := array.get(bins, pocIndex)
    int expansionSteps = 0
    while valueAreaVolume < targetVolume and expansionSteps < binCount
        bool canDown = vaLowIndex > 0
        bool canUp = vaHighIndex < binCount - 1
        if not canDown and not canUp
            break
        float downVol = canDown ? array.get(bins, vaLowIndex - 1) : -1.0
        float upVol = canUp ? array.get(bins, vaHighIndex + 1) : -1.0
        if canDown and canUp and downVol == upVol
            vaLowIndex -= 1
            vaHighIndex += 1
            valueAreaVolume += downVol + upVol
        else if canUp and (not canDown or upVol > downVol)
            vaHighIndex += 1
            valueAreaVolume += upVol
        else if canDown
            vaLowIndex -= 1
            valueAreaVolume += downVol
        expansionSteps += 1

    valPrice := profileLow + vaLowIndex * binSize
    vahPrice := profileLow + (vaHighIndex + 1) * binSize

float atr = ta.atr(atrLen)
bool valueReady = scopeActive and not na(pocPrice) and not na(vahPrice) and not na(valPrice)

float aboveRatio = ta.sma(valueReady and close > vahPrice ? 1.0 : 0.0, acceptanceLookback)
float belowRatio = ta.sma(valueReady and close < valPrice ? 1.0 : 0.0, acceptanceLookback)
float insideRatio = ta.sma(valueReady and close <= vahPrice and close >= valPrice ? 1.0 : 0.0, acceptanceLookback)

float signedAcceptance = valueReady ? f_clamp((nz(aboveRatio) - nz(belowRatio)) * 100.0, -100.0, 100.0) : na
float acceptanceStrength = valueReady ? math.max(nz(aboveRatio), math.max(nz(belowRatio), nz(insideRatio))) * 100.0 : na

float recentHigh = ta.highest(high, rejectionLookback)
float recentLow = ta.lowest(low, rejectionLookback)
float rejectAboveExcAtr = valueReady and not na(atr) and atr > 0.0 ? math.max(0.0, recentHigh - vahPrice) / atr : na
float rejectBelowExcAtr = valueReady and not na(atr) and atr > 0.0 ? math.max(0.0, valPrice - recentLow) / atr : na
bool rejectedAbove = valueReady and rejectAboveExcAtr > 0.0 and close <= vahPrice
bool rejectedBelow = valueReady and rejectBelowExcAtr > 0.0 and close >= valPrice
float rejectionStrength = rejectedAbove ? -f_clamp(rejectAboveExcAtr / maxRejectExcursionAtr * 100.0, 0.0, 100.0) : rejectedBelow ? f_clamp(rejectBelowExcAtr / maxRejectExcursionAtr * 100.0, 0.0, 100.0) : 0.0

bool pocCross = valueReady and not na(pocPrice[1]) and ((close > pocPrice and close[1] <= pocPrice[1]) or (close < pocPrice and close[1] >= pocPrice[1]))
float pocCrossRate = ta.sma(pocCross ? 1.0 : 0.0, rotationLookback)
float rotationStrength = valueReady and not na(pocCrossRate) ? f_clamp(pocCrossRate * 100.0, 0.0, 100.0) : na

float distanceFromPocAtr = valueReady and not na(atr) and atr > 0.0 ? (close - pocPrice) / atr : na
float directionalStrength = not na(distanceFromPocAtr) ? f_clamp(distanceFromPocAtr / strongDistanceAtr * 100.0, -100.0, 100.0) : na

bool previousReady = not na(completedVah) and not na(completedVal) and completedVah > completedVal
float currentMid = valueReady ? (vahPrice + valPrice) * 0.5 : na
float previousMid = previousReady ? (completedVah + completedVal) * 0.5 : na
float previousWidth = previousReady ? completedVah - completedVal : na
float displacementStrength = valueReady and previousReady and previousWidth > 0.0 ? f_clamp((currentMid - previousMid) / previousWidth * 100.0, -100.0, 100.0) : na

float directionalEvidence = (nz(signedAcceptance) * 0.35) + (rejectionStrength * 0.20) + (nz(directionalStrength) * 0.30) + (nz(displacementStrength) * 0.15)
float balanceEvidence = valueReady ? f_clamp((nz(insideRatio) * 70.0) + (nz(rotationStrength) * 0.30), 0.0, 100.0) : na
float imbalanceScore = valueReady ? f_clamp(directionalEvidence, -100.0, 100.0) : na
float balanceScore = valueReady ? f_clamp(nz(balanceEvidence) - math.abs(nz(imbalanceScore)) * 0.50, 0.0, 100.0) : na

string candidateState = "AUCTION_BALANCED"
if not valueReady
    candidateState := "AUCTION_UNAVAILABLE"
else if nz(imbalanceScore) >= 60.0
    candidateState := "AUCTION_STRONGLY_BULLISH"
else if nz(imbalanceScore) <= -60.0
    candidateState := "AUCTION_STRONGLY_BEARISH"
else if nz(imbalanceScore) >= 25.0
    candidateState := "AUCTION_BULLISH"
else if nz(imbalanceScore) <= -25.0
    candidateState := "AUCTION_BEARISH"
else if nz(balanceScore) >= 60.0
    candidateState := "AUCTION_BALANCED"
else if math.abs(rejectionStrength) >= 50.0
    candidateState := rejectionStrength > 0.0 ? "AUCTION_REJECTION_BULLISH" : "AUCTION_REJECTION_BEARISH"
else
    candidateState := "AUCTION_TRANSITION"

string state = barstate.isconfirmed ? candidateState : "FORMING"

float pocPlot = showValueLevels and scopeActive ? pocPrice : na
float vahPlot = showValueLevels and scopeActive ? vahPrice : na
float valPlot = showValueLevels and scopeActive ? valPrice : na
pocPlot := scopeReset ? na : pocPlot
vahPlot := scopeReset ? na : vahPlot
valPlot := scopeReset ? na : valPlot

plot(pocPlot, "Current POC", color=color.orange, linewidth=lineWidth, style=plot.style_linebr)
plot(vahPlot, "Current VAH", color=color.new(color.green, 10), linewidth=1, style=plot.style_linebr)
plot(valPlot, "Current VAL", color=color.new(color.red, 10), linewidth=1, style=plot.style_linebr)
plot(showPreviousLevels ? completedVah : na, "Previous VAH", color=color.new(color.green, 70), linewidth=1, style=plot.style_linebr)
plot(showPreviousLevels ? completedVal : na, "Previous VAL", color=color.new(color.red, 70), linewidth=1, style=plot.style_linebr)

var table diag = table.new(position.top_right, 2, 20, border_width=1, frame_width=1, bgcolor=color.new(color.black, 15))
f_setRow(int row, string labelText, string valueText) =>
    table.cell(diag, 0, row, labelText, text_color=color.silver, bgcolor=color.new(color.black, 15), text_halign=text.align_left)
    table.cell(diag, 1, row, valueText, text_color=color.white, bgcolor=color.new(color.black, 15), text_halign=text.align_right)

if barstate.islast
    if showTable
        table.clear(diag, 0, 0, 1, 19)
        f_setRow(0, "PLUTUS", "P04.2 Auction Strength")
        f_setRow(1, "Timezone", sessionTz)
        f_setRow(2, "Scope", profileScope)
        f_setRow(3, "Scope State", scopeActive ? "ACTIVE" : "CLOSED")
        f_setRow(4, "Stored Bars", str.tostring(storedBars))
        f_setRow(5, "VAH", not na(vahPrice) ? str.tostring(vahPrice, format.mintick) : "N/A")
        f_setRow(6, "POC", not na(pocPrice) ? str.tostring(pocPrice, format.mintick) : "N/A")
        f_setRow(7, "VAL", not na(valPrice) ? str.tostring(valPrice, format.mintick) : "N/A")
        f_setRow(8, "Acceptance Strength", not na(acceptanceStrength) ? str.tostring(acceptanceStrength, "#.1") : "N/A")
        f_setRow(9, "Signed Acceptance", not na(signedAcceptance) ? str.tostring(signedAcceptance, "#.1") : "N/A")
        f_setRow(10, "Rejection Strength", str.tostring(rejectionStrength, "#.1"))
        f_setRow(11, "Rotation Strength", not na(rotationStrength) ? str.tostring(rotationStrength, "#.1") : "N/A")
        f_setRow(12, "Directional Strength", not na(directionalStrength) ? str.tostring(directionalStrength, "#.1") : "N/A")
        f_setRow(13, "Displacement Strength", not na(displacementStrength) ? str.tostring(displacementStrength, "#.1") : "N/A")
        f_setRow(14, "Imbalance Score", not na(imbalanceScore) ? str.tostring(imbalanceScore, "#.1") : "N/A")
        f_setRow(15, "Balance Score", not na(balanceScore) ? str.tostring(balanceScore, "#.1") : "N/A")
        f_setRow(16, "Reject Above ATR", not na(rejectAboveExcAtr) ? str.tostring(rejectAboveExcAtr, "#.###") : "N/A")
        f_setRow(17, "Reject Below ATR", not na(rejectBelowExcAtr) ? str.tostring(rejectBelowExcAtr, "#.###") : "N/A")
        f_setRow(18, "Confirmed", barstate.isconfirmed ? "YES" : "NO")
        f_setRow(19, "State", state)
    else
        table.clear(diag, 0, 0, 1, 19)
