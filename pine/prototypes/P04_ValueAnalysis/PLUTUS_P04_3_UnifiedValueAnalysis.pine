//@version=6
indicator("PLUTUS P04.3 — Unified Value Analysis", shorttitle="PLUTUS P04.3", overlay=true, max_labels_count=50)

//==============================================================================
// PLUTUS P04.3 — Unified Value Analysis State
// Consolidates P04.0-P04.2 into one downstream-ready value engine.
// Context only; no trade signals.
//==============================================================================

//------------------------------------------------------------------------------
// Inputs
//------------------------------------------------------------------------------
groupTiming = "Timing / Timezone"
timezoneInput = input.string("Exchange", "Session Timezone", options=["Exchange", "UTC-2", "UTC-1", "UTC+0", "UTC+1", "UTC+2", "America/New_York", "Europe/London", "Asia/Tokyo"], group=groupTiming)
string sessionTz = timezoneInput == "Exchange" ? syminfo.timezone : timezoneInput

groupProfile = "Profile Engine"
profileScope = input.string("New York", "Profile Scope", options=["Asia", "London", "New York", "Day"], group=groupProfile)
allocationSource = input.source(hlc3, "Allocation Price", group=groupProfile)
binCount = input.int(24, "Price Bins", minval=8, maxval=80, group=groupProfile)
maxProfileBars = input.int(300, "Maximum Bars Per Profile", minval=25, maxval=1000, group=groupProfile)
valueAreaPct = input.float(70.0, "Value Area %", minval=50.0, maxval=99.0, step=1.0, group=groupProfile)

groupBehavior = "Auction Behavior"
acceptanceLookback = input.int(5, "Acceptance Lookback", minval=2, maxval=30, group=groupBehavior)
acceptanceRatioMin = input.float(0.70, "Acceptance Ratio", minval=0.50, maxval=1.0, step=0.05, group=groupBehavior)
rejectionLookback = input.int(3, "Rejection Lookback", minval=1, maxval=10, group=groupBehavior)
rotationLookback = input.int(10, "POC Rotation Lookback", minval=3, maxval=50, group=groupBehavior)
minPocCrosses = input.int(3, "Minimum POC Crosses", minval=1, maxval=20, group=groupBehavior)

groupRelationship = "Value Relationship"
minShiftPct = input.float(10.0, "Minimum Midpoint Shift / Previous VA Width %", minval=0.0, maxval=100.0, step=5.0, group=groupRelationship)
strongSeparationAtr = input.float(0.25, "Strong Separation Gap / ATR", minval=0.0, step=0.05, group=groupRelationship)

groupStrength = "Strength / Unified State"
atrLen = input.int(14, "ATR Length", minval=1, group=groupStrength)
strongDistanceAtr = input.float(1.0, "Full Directional Strength Distance / ATR", minval=0.10, step=0.10, group=groupStrength)
maxRejectExcursionAtr = input.float(1.0, "Full Rejection Excursion / ATR", minval=0.10, step=0.10, group=groupStrength)
strongStateThreshold = input.float(55.0, "Strong Unified State Threshold", minval=25.0, maxval=90.0, step=5.0, group=groupStrength)
directionalStateThreshold = input.float(25.0, "Directional State Threshold", minval=5.0, maxval=75.0, step=5.0, group=groupStrength)
conflictThreshold = input.float(30.0, "Conflict Threshold", minval=10.0, maxval=80.0, step=5.0, group=groupStrength)

groupDisplay = "Display"
showCurrentLevels = input.bool(true, "Show Current POC / VAH / VAL", group=groupDisplay)
showPreviousLevels = input.bool(false, "Show Previous Completed POC / VAH / VAL", group=groupDisplay)
showTable = input.bool(true, "Show Diagnostic Table", group=groupDisplay)
lineWidth = input.int(2, "Line Width", minval=1, maxval=4, group=groupDisplay)

//------------------------------------------------------------------------------
// Helpers
//------------------------------------------------------------------------------
f_clamp(float x, float lo, float hi) =>
    math.max(lo, math.min(hi, x))

//------------------------------------------------------------------------------
// Fixed ARTHA-compatible sessions
//------------------------------------------------------------------------------
string asiaSession = "0000-0800:1234567"
string londonSession = "0800-1630:1234567"
string newYorkSession = "1330-2000:1234567"

bool inAsia = not na(time(timeframe.period, asiaSession, sessionTz))
bool inLondon = not na(time(timeframe.period, londonSession, sessionTz))
bool inNewYork = not na(time(timeframe.period, newYorkSession, sessionTz))
bool newAsia = inAsia and not inAsia[1]
bool newLondon = inLondon and not inLondon[1]
bool newNewYork = inNewYork and not inNewYork[1]
int localDay = dayofmonth(time, sessionTz)
bool newDay = ta.change(localDay) != 0

bool scopeActive = switch profileScope
    "Asia" => inAsia
    "London" => inLondon
    "New York" => inNewYork
    => true

bool scopeReset = switch profileScope
    "Asia" => newAsia
    "London" => newLondon
    "New York" => newNewYork
    => barstate.isfirst or newDay

//------------------------------------------------------------------------------
// Bounded profile storage
//------------------------------------------------------------------------------
var array<float> profilePrices = array.new_float()
var array<float> profileHighs = array.new_float()
var array<float> profileLows = array.new_float()
var array<float> profileVolumes = array.new_float()
var array<float> bins = array.new_float()

if barstate.isfirst
    for i = 0 to binCount - 1
        array.push(bins, 0.0)

float profileHigh = na
float profileLow = na
float pocPrice = na
float vahPrice = na
float valPrice = na
float totalProfileVolume = 0.0
float valueAreaVolume = 0.0
float binSize = na
int pocIndex = na
int vaLowIndex = na
int vaHighIndex = na

var float completedPoc = na
var float completedVah = na
var float completedVal = na

if scopeReset and not barstate.isfirst
    completedPoc := pocPrice[1]
    completedVah := vahPrice[1]
    completedVal := valPrice[1]

if scopeReset
    array.clear(profilePrices)
    array.clear(profileHighs)
    array.clear(profileLows)
    array.clear(profileVolumes)

if scopeActive and not na(volume)
    array.push(profilePrices, allocationSource)
    array.push(profileHighs, high)
    array.push(profileLows, low)
    array.push(profileVolumes, volume)
    if array.size(profilePrices) > maxProfileBars
        array.shift(profilePrices)
        array.shift(profileHighs)
        array.shift(profileLows)
        array.shift(profileVolumes)

//------------------------------------------------------------------------------
// Rebuild current profile + value area
//------------------------------------------------------------------------------
int storedBars = array.size(profilePrices)
if storedBars > 0
    profileHigh := array.max(profileHighs)
    profileLow := array.min(profileLows)
    float profileRange = profileHigh - profileLow
    binSize := math.max(profileRange > 0.0 ? profileRange / binCount : syminfo.mintick, syminfo.mintick)

    for i = 0 to binCount - 1
        array.set(bins, i, 0.0)

    for i = 0 to storedBars - 1
        float p = array.get(profilePrices, i)
        float v = array.get(profileVolumes, i)
        int idx = int(math.floor((p - profileLow) / binSize))
        idx := math.max(0, math.min(binCount - 1, idx))
        array.set(bins, idx, array.get(bins, idx) + v)
        totalProfileVolume += v

    float maxBinVol = -1.0
    pocIndex := 0
    for i = 0 to binCount - 1
        float binVol = array.get(bins, i)
        if binVol > maxBinVol
            maxBinVol := binVol
            pocIndex := i

    pocPrice := profileLow + (pocIndex + 0.5) * binSize
    float targetVolume = totalProfileVolume * valueAreaPct / 100.0
    vaLowIndex := pocIndex
    vaHighIndex := pocIndex
    valueAreaVolume := array.get(bins, pocIndex)
    int expansionSteps = 0

    while valueAreaVolume < targetVolume and expansionSteps < binCount
        bool canDown = vaLowIndex > 0
        bool canUp = vaHighIndex < binCount - 1
        if not canDown and not canUp
            break
        float downVol = canDown ? array.get(bins, vaLowIndex - 1) : -1.0
        float upVol = canUp ? array.get(bins, vaHighIndex + 1) : -1.0
        if canDown and canUp and downVol == upVol
            vaLowIndex -= 1
            vaHighIndex += 1
            valueAreaVolume += downVol + upVol
        else if canUp and (not canDown or upVol > downVol)
            vaHighIndex += 1
            valueAreaVolume += upVol
        else if canDown
            vaLowIndex -= 1
            valueAreaVolume += downVol
        expansionSteps += 1

    valPrice := profileLow + vaLowIndex * binSize
    vahPrice := profileLow + (vaHighIndex + 1) * binSize

//------------------------------------------------------------------------------
// P04.0 behavior layer
//------------------------------------------------------------------------------
float atr = ta.atr(atrLen)
bool valueReady = scopeActive and not na(pocPrice) and not na(vahPrice) and not na(valPrice)

float aboveRatio = ta.sma(valueReady and close > vahPrice ? 1.0 : 0.0, acceptanceLookback)
float belowRatio = ta.sma(valueReady and close < valPrice ? 1.0 : 0.0, acceptanceLookback)
float insideRatio = ta.sma(valueReady and close <= vahPrice and close >= valPrice ? 1.0 : 0.0, acceptanceLookback)

bool acceptedAbove = valueReady and not na(aboveRatio) and aboveRatio >= acceptanceRatioMin
bool acceptedBelow = valueReady and not na(belowRatio) and belowRatio >= acceptanceRatioMin
bool acceptedInside = valueReady and not na(insideRatio) and insideRatio >= acceptanceRatioMin

bool recentlyAbove = ta.highest(valueReady and close > vahPrice ? 1.0 : 0.0, rejectionLookback) > 0
bool recentlyBelow = ta.highest(valueReady and close < valPrice ? 1.0 : 0.0, rejectionLookback) > 0
bool rejectedFromAbove = valueReady and recentlyAbove and close < vahPrice and close >= valPrice
bool rejectedFromBelow = valueReady and recentlyBelow and close > valPrice and close <= vahPrice
bool failedAcceptanceAbove = acceptedAbove[1] and valueReady and close < vahPrice
bool failedAcceptanceBelow = acceptedBelow[1] and valueReady and close > valPrice

bool pocCross = valueReady and not na(pocPrice[1]) and ((close > pocPrice and close[1] <= pocPrice[1]) or (close < pocPrice and close[1] >= pocPrice[1]))
float pocCrossRate = ta.sma(pocCross ? 1.0 : 0.0, rotationLookback)
float approximatePocCrosses = not na(pocCrossRate) ? pocCrossRate * rotationLookback : na
bool rotatingAtPoc = valueReady and not na(approximatePocCrosses) and approximatePocCrosses >= minPocCrosses and acceptedInside

string behaviorState = "VALUE_TRANSITION"
if not valueReady
    behaviorState := "VALUE_UNAVAILABLE"
else if failedAcceptanceAbove
    behaviorState := "FAILED_ACCEPTANCE_ABOVE"
else if failedAcceptanceBelow
    behaviorState := "FAILED_ACCEPTANCE_BELOW"
else if rejectedFromAbove
    behaviorState := "REJECTION_FROM_ABOVE_VALUE"
else if rejectedFromBelow
    behaviorState := "REJECTION_FROM_BELOW_VALUE"
else if acceptedAbove
    behaviorState := "ACCEPTANCE_ABOVE_VALUE"
else if acceptedBelow
    behaviorState := "ACCEPTANCE_BELOW_VALUE"
else if rotatingAtPoc
    behaviorState := "ROTATION_AROUND_POC"
else if acceptedInside
    behaviorState := "ACCEPTANCE_INSIDE_VALUE"

//------------------------------------------------------------------------------
// P04.1 relationship layer
//------------------------------------------------------------------------------
bool previousReady = not na(completedVah) and not na(completedVal) and completedVah > completedVal
bool relationshipReady = valueReady and previousReady
float currentWidth = valueReady ? vahPrice - valPrice : na
float previousWidth = previousReady ? completedVah - completedVal : na
float currentMid = valueReady ? (vahPrice + valPrice) * 0.5 : na
float previousMid = previousReady ? (completedVah + completedVal) * 0.5 : na
float overlapLow = relationshipReady ? math.max(valPrice, completedVal) : na
float overlapHigh = relationshipReady ? math.min(vahPrice, completedVah) : na
float overlapWidth = relationshipReady ? math.max(0.0, overlapHigh - overlapLow) : na
float referenceWidth = relationshipReady ? math.min(currentWidth, previousWidth) : na
float overlapPct = relationshipReady and referenceWidth > 0.0 ? overlapWidth / referenceWidth * 100.0 : na
float midpointShift = relationshipReady ? currentMid - previousMid : na
float midpointShiftPct = relationshipReady and previousWidth > 0.0 ? midpointShift / previousWidth * 100.0 : na
bool separatedHigher = relationshipReady and valPrice >= completedVah
bool separatedLower = relationshipReady and vahPrice <= completedVal
float separationGap = separatedHigher ? valPrice - completedVah : separatedLower ? completedVal - vahPrice : 0.0
float separationGapAtr = relationshipReady and not na(atr) and atr > 0.0 ? separationGap / atr : na
bool strongSeparatedHigher = separatedHigher and not na(separationGapAtr) and separationGapAtr >= strongSeparationAtr
bool strongSeparatedLower = separatedLower and not na(separationGapAtr) and separationGapAtr >= strongSeparationAtr
bool currentInsidePrevious = relationshipReady and valPrice >= completedVal and vahPrice <= completedVah and not separatedHigher and not separatedLower
bool currentEngulfsPrevious = relationshipReady and valPrice <= completedVal and vahPrice >= completedVah and not separatedHigher and not separatedLower
bool hasOverlap = relationshipReady and overlapWidth > 0.0
bool shiftedHigher = hasOverlap and not na(midpointShiftPct) and midpointShiftPct >= minShiftPct
bool shiftedLower = hasOverlap and not na(midpointShiftPct) and midpointShiftPct <= -minShiftPct
float displacementStrength = relationshipReady and previousWidth > 0.0 ? f_clamp(midpointShift / previousWidth * 100.0, -100.0, 100.0) : na

string relationshipState = "VALUE_RELATIONSHIP_TRANSITION"
if not relationshipReady
    relationshipState := "VALUE_RELATIONSHIP_UNAVAILABLE"
else if strongSeparatedHigher
    relationshipState := "VALUE_STRONGLY_SEPARATED_HIGHER"
else if strongSeparatedLower
    relationshipState := "VALUE_STRONGLY_SEPARATED_LOWER"
else if separatedHigher
    relationshipState := "VALUE_SEPARATED_HIGHER"
else if separatedLower
    relationshipState := "VALUE_SEPARATED_LOWER"
else if currentInsidePrevious
    relationshipState := "VALUE_INSIDE_PREVIOUS"
else if currentEngulfsPrevious
    relationshipState := "VALUE_ENGULFS_PREVIOUS"
else if shiftedHigher
    relationshipState := "VALUE_OVERLAPPING_HIGHER"
else if shiftedLower
    relationshipState := "VALUE_OVERLAPPING_LOWER"
else if hasOverlap
    relationshipState := "VALUE_OVERLAPPING"

//------------------------------------------------------------------------------
// P04.2 strength layer
//------------------------------------------------------------------------------
float signedAcceptance = valueReady ? f_clamp((nz(aboveRatio) - nz(belowRatio)) * 100.0, -100.0, 100.0) : na
float acceptanceStrength = valueReady ? math.max(nz(aboveRatio), math.max(nz(belowRatio), nz(insideRatio))) * 100.0 : na
float recentHigh = ta.highest(high, rejectionLookback)
float recentLow = ta.lowest(low, rejectionLookback)
float rejectAboveExcAtr = valueReady and not na(atr) and atr > 0.0 ? math.max(0.0, recentHigh - vahPrice) / atr : na
float rejectBelowExcAtr = valueReady and not na(atr) and atr > 0.0 ? math.max(0.0, valPrice - recentLow) / atr : na
bool rejectedAboveStrength = valueReady and rejectAboveExcAtr > 0.0 and close <= vahPrice
bool rejectedBelowStrength = valueReady and rejectBelowExcAtr > 0.0 and close >= valPrice
float rejectionStrength = rejectedAboveStrength ? -f_clamp(rejectAboveExcAtr / maxRejectExcursionAtr * 100.0, 0.0, 100.0) : rejectedBelowStrength ? f_clamp(rejectBelowExcAtr / maxRejectExcursionAtr * 100.0, 0.0, 100.0) : 0.0
float rotationStrength = valueReady and not na(pocCrossRate) ? f_clamp(pocCrossRate * 100.0, 0.0, 100.0) : na
float distanceFromPocAtr = valueReady and not na(atr) and atr > 0.0 ? (close - pocPrice) / atr : na
float directionalStrength = not na(distanceFromPocAtr) ? f_clamp(distanceFromPocAtr / strongDistanceAtr * 100.0, -100.0, 100.0) : na
float auctionImbalanceScore = valueReady ? f_clamp(nz(signedAcceptance) * 0.35 + rejectionStrength * 0.20 + nz(directionalStrength) * 0.30 + nz(displacementStrength) * 0.15, -100.0, 100.0) : na
float balanceEvidence = valueReady ? f_clamp(nz(insideRatio) * 70.0 + nz(rotationStrength) * 0.30, 0.0, 100.0) : na
float balanceScore = valueReady ? f_clamp(nz(balanceEvidence) - math.abs(nz(auctionImbalanceScore)) * 0.50, 0.0, 100.0) : na

//------------------------------------------------------------------------------
// Unified value-analysis scores
//------------------------------------------------------------------------------
float relationshipDirectional = relationshipReady ? f_clamp(nz(displacementStrength), -100.0, 100.0) : 0.0
float rejectionDirectional = f_clamp(rejectionStrength, -100.0, 100.0)
float acceptanceDirectional = f_clamp(nz(signedAcceptance), -100.0, 100.0)
float priceDirectional = f_clamp(nz(directionalStrength), -100.0, 100.0)

float valueAnalysisScore = valueReady ? f_clamp(
     acceptanceDirectional * 0.30 +
     rejectionDirectional * 0.20 +
     priceDirectional * 0.25 +
     relationshipDirectional * 0.25,
     -100.0, 100.0) : na

float agreementScore = valueReady ? 100.0 - f_clamp(math.abs(auctionImbalanceScore - relationshipDirectional), 0.0, 100.0) : na
bool directionalConflict = relationshipReady and math.abs(auctionImbalanceScore) >= conflictThreshold and math.abs(relationshipDirectional) >= conflictThreshold and math.sign(auctionImbalanceScore) != math.sign(relationshipDirectional)
float confidenceScore = valueReady ? f_clamp(math.max(math.abs(nz(valueAnalysisScore)), nz(balanceScore)) * 0.70 + nz(agreementScore) * 0.30, 0.0, 100.0) : na

//------------------------------------------------------------------------------
// Unified state
//------------------------------------------------------------------------------
string candidateState = "VALUE_ANALYSIS_TRANSITION"
if not valueReady
    candidateState := "VALUE_ANALYSIS_UNAVAILABLE"
else if directionalConflict
    candidateState := "VALUE_ANALYSIS_CONFLICT"
else if failedAcceptanceAbove
    candidateState := "VALUE_FAILURE_BEARISH"
else if failedAcceptanceBelow
    candidateState := "VALUE_FAILURE_BULLISH"
else if rejectedFromAbove and rejectionStrength < 0.0
    candidateState := "VALUE_REJECTION_BEARISH"
else if rejectedFromBelow and rejectionStrength > 0.0
    candidateState := "VALUE_REJECTION_BULLISH"
else if nz(valueAnalysisScore) >= strongStateThreshold and (separatedHigher or shiftedHigher or acceptedAbove)
    candidateState := "VALUE_STRONGLY_BULLISH"
else if nz(valueAnalysisScore) <= -strongStateThreshold and (separatedLower or shiftedLower or acceptedBelow)
    candidateState := "VALUE_STRONGLY_BEARISH"
else if nz(valueAnalysisScore) >= directionalStateThreshold
    candidateState := "VALUE_BULLISH"
else if nz(valueAnalysisScore) <= -directionalStateThreshold
    candidateState := "VALUE_BEARISH"
else if nz(balanceScore) >= 60.0 and (acceptedInside or rotatingAtPoc or currentInsidePrevious or hasOverlap)
    candidateState := "VALUE_BALANCED"
else if currentEngulfsPrevious
    candidateState := "VALUE_EXPANDING"
else
    candidateState := "VALUE_ANALYSIS_TRANSITION"

string state = barstate.isconfirmed ? candidateState : "FORMING"

//------------------------------------------------------------------------------
// Plots
//------------------------------------------------------------------------------
float pocPlot = showCurrentLevels and scopeActive ? pocPrice : na
float vahPlot = showCurrentLevels and scopeActive ? vahPrice : na
float valPlot = showCurrentLevels and scopeActive ? valPrice : na
pocPlot := scopeReset ? na : pocPlot
vahPlot := scopeReset ? na : vahPlot
valPlot := scopeReset ? na : valPlot

plot(pocPlot, "Current POC", color=color.orange, linewidth=lineWidth, style=plot.style_linebr)
plot(vahPlot, "Current VAH", color=color.new(color.green, 10), linewidth=1, style=plot.style_linebr)
plot(valPlot, "Current VAL", color=color.new(color.red, 10), linewidth=1, style=plot.style_linebr)
plot(showPreviousLevels ? completedPoc : na, "Previous POC", color=color.new(color.orange, 65), linewidth=1, style=plot.style_linebr)
plot(showPreviousLevels ? completedVah : na, "Previous VAH", color=color.new(color.green, 75), linewidth=1, style=plot.style_linebr)
plot(showPreviousLevels ? completedVal : na, "Previous VAL", color=color.new(color.red, 75), linewidth=1, style=plot.style_linebr)

//------------------------------------------------------------------------------
// Diagnostics
//------------------------------------------------------------------------------
var table diag = table.new(position.top_right, 2, 22, border_width=1, frame_width=1, bgcolor=color.new(color.black, 15))
f_setRow(int row, string labelText, string valueText) =>
    table.cell(diag, 0, row, labelText, text_color=color.silver, bgcolor=color.new(color.black, 15), text_halign=text.align_left)
    table.cell(diag, 1, row, valueText, text_color=color.white, bgcolor=color.new(color.black, 15), text_halign=text.align_right)

if barstate.islast
    if showTable
        table.clear(diag, 0, 0, 1, 21)
        f_setRow(0, "PLUTUS", "P04.3 Unified Value")
        f_setRow(1, "Timezone", sessionTz)
        f_setRow(2, "Scope", profileScope)
        f_setRow(3, "Scope State", scopeActive ? "ACTIVE" : "CLOSED")
        f_setRow(4, "Stored Bars", str.tostring(storedBars))
        f_setRow(5, "VAH", not na(vahPrice) ? str.tostring(vahPrice, format.mintick) : "N/A")
        f_setRow(6, "POC", not na(pocPrice) ? str.tostring(pocPrice, format.mintick) : "N/A")
        f_setRow(7, "VAL", not na(valPrice) ? str.tostring(valPrice, format.mintick) : "N/A")
        f_setRow(8, "Behavior", behaviorState)
        f_setRow(9, "Relationship", relationshipState)
        f_setRow(10, "Acceptance", not na(acceptanceStrength) ? str.tostring(acceptanceStrength, "#.1") : "N/A")
        f_setRow(11, "Signed Acceptance", not na(signedAcceptance) ? str.tostring(signedAcceptance, "#.1") : "N/A")
        f_setRow(12, "Rejection", str.tostring(rejectionStrength, "#.1"))
        f_setRow(13, "Rotation", not na(rotationStrength) ? str.tostring(rotationStrength, "#.1") : "N/A")
        f_setRow(14, "Auction Imbalance", not na(auctionImbalanceScore) ? str.tostring(auctionImbalanceScore, "#.1") : "N/A")
        f_setRow(15, "Balance", not na(balanceScore) ? str.tostring(balanceScore, "#.1") : "N/A")
        f_setRow(16, "Overlap %", not na(overlapPct) ? str.tostring(overlapPct, "#.1") + "%" : "N/A")
        f_setRow(17, "Displacement", not na(displacementStrength) ? str.tostring(displacementStrength, "#.1") : "N/A")
        f_setRow(18, "Conflict", directionalConflict ? "YES" : "NO")
        f_setRow(19, "Value Analysis Score", not na(valueAnalysisScore) ? str.tostring(valueAnalysisScore, "#.1") : "N/A")
        f_setRow(20, "Confidence", not na(confidenceScore) ? str.tostring(confidenceScore, "#.1") : "N/A")
        f_setRow(21, "State", state)
    else
        table.clear(diag, 0, 0, 1, 21)
