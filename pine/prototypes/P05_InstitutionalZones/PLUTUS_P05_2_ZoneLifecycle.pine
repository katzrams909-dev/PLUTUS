//@version=6
indicator("PLUTUS P05.2 — Zone Lifecycle", shorttitle="PLUTUS P05.2", overlay=true, max_boxes_count=200, max_labels_count=50)

//==============================================================================
// PLUTUS P05.2 — Zone Mitigation / IFVG / Breaker Lifecycle Refinement
// Refines P05.1 post-creation behavior:
// fresh -> partial mitigation -> full mitigation / invalidation / expiry,
// with FVG -> IFVG and OB -> Breaker inversion paths.
// Context engine only. No trade signals.
//==============================================================================

//------------------------------------------------------------------------------
// Inputs
//------------------------------------------------------------------------------
groupTiming = "Timing / Context"
timezoneInput = input.string("Exchange", "Session Timezone", options=["Exchange", "UTC-2", "UTC-1", "UTC+0", "UTC+1", "UTC+2", "America/New_York", "Europe/London", "Asia/Tokyo"], group=groupTiming)
string sessionTz = timezoneInput == "Exchange" ? syminfo.timezone : timezoneInput
profileScope = input.string("New York", "Profile Scope", options=["Asia", "London", "New York", "Day"], group=groupTiming)
valueReference = input.string("Daily", "VWAP Reference", options=["Active Session", "Daily", "Weekly", "Monthly"], group=groupTiming)

groupDetection = "Candidate Detection"
atrLen = input.int(14, "ATR Length", minval=1, group=groupDetection)
volumeLen = input.int(20, "Volume Baseline Length", minval=2, group=groupDetection)
minDisplacementAtr = input.float(0.35, "Minimum Displacement Body / ATR", minval=0.05, step=0.05, group=groupDetection)
fullDisplacementAtr = input.float(1.0, "Full Mechanical Displacement / ATR", minval=0.10, step=0.10, group=groupDetection)
minFvgAtr = input.float(0.05, "Minimum FVG Width / ATR", minval=0.0, step=0.01, group=groupDetection)
maxZoneWidthAtr = input.float(2.0, "Maximum Zone Width / ATR", minval=0.25, step=0.25, group=groupDetection)
detectFvg = input.bool(true, "Detect FVG Candidates", group=groupDetection)
detectOb = input.bool(true, "Detect Order Block Candidates", group=groupDetection)

groupQualification = "Qualification"
minQualificationScore = input.float(60.0, "Institutional Qualification Score", minval=0.0, maxval=100.0, step=5.0, group=groupQualification)
fullRvol = input.float(2.0, "Full Participation RVOL", minval=1.0, step=0.1, group=groupQualification)
fullVwapDistanceAtr = input.float(1.0, "Full VWAP Distance / ATR", minval=0.10, step=0.10, group=groupQualification)
fullPocDistanceAtr = input.float(1.0, "Full POC Distance / ATR", minval=0.10, step=0.10, group=groupQualification)

groupLifecycle = "Lifecycle / Mitigation"
mitigationBasis = input.string("Wick", "Mitigation Basis", options=["Wick", "Close"], group=groupLifecycle)
partialMitigationPct = input.float(25.0, "Partial Mitigation Threshold %", minval=1.0, maxval=95.0, step=5.0, group=groupLifecycle)
fullMitigationPct = input.float(95.0, "Full Mitigation Threshold %", minval=5.0, maxval=100.0, step=5.0, group=groupLifecycle)
mitigationPenaltyMax = input.float(25.0, "Maximum Mitigation Score Penalty", minval=0.0, maxval=75.0, step=5.0, group=groupLifecycle)
retestPenalty = input.float(5.0, "Penalty Per Retest", minval=0.0, maxval=25.0, step=1.0, group=groupLifecycle)
freshnessDecayPer100Bars = input.float(10.0, "Freshness Decay Per 100 Bars", minval=0.0, maxval=50.0, step=1.0, group=groupLifecycle)
maxZoneAgeBars = input.int(250, "Maximum Zone Age (Bars)", minval=10, maxval=2000, group=groupLifecycle)
maxTrackedZones = input.int(30, "Maximum Tracked Zones", minval=4, maxval=80, group=groupLifecycle)
removeFullyMitigated = input.bool(true, "Remove Fully Mitigated Zones", group=groupLifecycle)
removeInvalidated = input.bool(true, "Remove Invalidated Zones", group=groupLifecycle)
removeExpired = input.bool(true, "Remove Expired Zones", group=groupLifecycle)

groupInversion = "Inversion / Breakers"
createIfvg = input.bool(true, "Create IFVG From Invalidated FVG", group=groupInversion)
createBreaker = input.bool(true, "Create Breaker From Invalidated OB", group=groupInversion)
inversionMechanicFactor = input.float(0.75, "Inherited Mechanical Quality", minval=0.25, maxval=1.0, step=0.05, group=groupInversion)
minInversionScore = input.float(55.0, "Minimum Inversion Qualification", minval=0.0, maxval=100.0, step=5.0, group=groupInversion)

groupProfile = "Profile Context"
allocationSource = input.source(hlc3, "Profile Allocation Price", group=groupProfile)
binCount = input.int(24, "Profile Price Bins", minval=8, maxval=80, group=groupProfile)
maxProfileBars = input.int(300, "Maximum Bars Per Profile", minval=25, maxval=1000, group=groupProfile)
valueAreaPct = input.float(70.0, "Value Area %", minval=50.0, maxval=99.0, step=1.0, group=groupProfile)

groupDisplay = "Display"
showCandidates = input.bool(true, "Show Zones", group=groupDisplay)
showOnlyQualified = input.bool(true, "Show Only Qualified Zones", group=groupDisplay)
showZoneText = input.bool(true, "Show Type / Score / Lifecycle", group=groupDisplay)
showVwap = input.bool(false, "Show Primary VWAP", group=groupDisplay)
showValueLevels = input.bool(false, "Show Profile POC / VAH / VAL", group=groupDisplay)
showHistogram = input.bool(false, "Show Volume Profile Histogram", group=groupDisplay)
histogramOffset = input.int(4, "Histogram Right Offset", minval=1, maxval=50, group=groupDisplay)
histogramMaxWidth = input.int(24, "Histogram Maximum Width", minval=5, maxval=100, group=groupDisplay)
showTable = input.bool(true, "Show Diagnostic Table", group=groupDisplay)

//------------------------------------------------------------------------------
// Helpers
//------------------------------------------------------------------------------
f_clamp(float x, float lo, float hi) =>
    math.max(lo, math.min(hi, x))

f_widthQuality(float widthAtr) =>
    float q = na(widthAtr) ? 0.0 : widthAtr <= 1.0 ? 100.0 : 100.0 * (1.0 - (widthAtr - 1.0) / math.max(maxZoneWidthAtr - 1.0, 0.01))
    f_clamp(q, 0.0, 100.0)

f_mechanicQuality(float displacementAtr, float widthAtr) =>
    float d = not na(displacementAtr) ? f_clamp(displacementAtr / fullDisplacementAtr * 100.0, 0.0, 100.0) : 0.0
    f_clamp(d * 0.65 + f_widthQuality(widthAtr) * 0.35, 0.0, 100.0)

f_support(int direction, float signedScore) =>
    f_clamp(direction * nz(signedScore), 0.0, 100.0)

f_zoneScore(float mechanic, float p01, float p02, float p03, float p04) =>
    f_clamp(mechanic * 0.20 + p01 * 0.25 + p02 * 0.20 + p03 * 0.15 + p04 * 0.20, 0.0, 100.0)

f_statusText(int status) =>
    status == 0 ? "F" : status == 1 ? "P" : status == 2 ? "M" : status == 3 ? "X" : "E"

//------------------------------------------------------------------------------
// Shared timing
//------------------------------------------------------------------------------
string asiaSession = "0000-0800:1234567"
string londonSession = "0800-1630:1234567"
string newYorkSession = "1330-2000:1234567"

bool inAsia = not na(time(timeframe.period, asiaSession, sessionTz))
bool inLondon = not na(time(timeframe.period, londonSession, sessionTz))
bool inNewYork = not na(time(timeframe.period, newYorkSession, sessionTz))
bool newAsia = inAsia and not inAsia[1]
bool newLondon = inLondon and not inLondon[1]
bool newNewYork = inNewYork and not inNewYork[1]
int localDay = dayofmonth(time, sessionTz)
int localWeek = weekofyear(time, sessionTz)
int localMonth = month(time, sessionTz)
bool newDay = ta.change(localDay) != 0
bool newWeek = ta.change(localWeek) != 0
bool newMonth = ta.change(localMonth) != 0

bool profileActive = switch profileScope
    "Asia" => inAsia
    "London" => inLondon
    "New York" => inNewYork
    => true

bool profileReset = switch profileScope
    "Asia" => newAsia
    "London" => newLondon
    "New York" => newNewYork
    => barstate.isfirst or newDay

//------------------------------------------------------------------------------
// Compact P01 participation evidence
//------------------------------------------------------------------------------
float atr = ta.atr(atrLen)
float body = math.abs(close - open)
float candleRange = math.max(high - low, syminfo.mintick)
float bodyAtr = not na(atr) and atr > 0.0 ? body / atr : na
float bodyEfficiency = body / candleRange
float volumeBase = ta.sma(volume, volumeLen)
float rvol = not na(volume) and not na(volumeBase) and volumeBase > 0.0 ? volume / volumeBase : na
float participationMagnitude = not na(rvol) ? f_clamp((rvol - 0.75) / math.max(fullRvol - 0.75, 0.01) * 100.0, 0.0, 100.0) : 0.0
float efficiencyMagnitude = f_clamp(bodyEfficiency * 100.0, 0.0, 100.0)
int candleDirection = close > open ? 1 : close < open ? -1 : 0
float p01Signed = candleDirection * f_clamp(participationMagnitude * 0.65 + efficiencyMagnitude * 0.35, 0.0, 100.0)

//------------------------------------------------------------------------------
// P02 fair-value evidence + hard reset-aware VWAP plots
//------------------------------------------------------------------------------
var float asiaPV = na
var float asiaVol = na
if not inAsia
    asiaPV := na
    asiaVol := na
else if newAsia or na(asiaPV) or na(asiaVol)
    asiaPV := hlc3 * volume
    asiaVol := volume
else
    asiaPV += hlc3 * volume
    asiaVol += volume
float asiaVwap = inAsia and not na(asiaVol) and asiaVol > 0.0 ? asiaPV / asiaVol : na

var float londonPV = na
var float londonVol = na
if not inLondon
    londonPV := na
    londonVol := na
else if newLondon or na(londonPV) or na(londonVol)
    londonPV := hlc3 * volume
    londonVol := volume
else
    londonPV += hlc3 * volume
    londonVol += volume
float londonVwap = inLondon and not na(londonVol) and londonVol > 0.0 ? londonPV / londonVol : na

var float newYorkPV = na
var float newYorkVol = na
if not inNewYork
    newYorkPV := na
    newYorkVol := na
else if newNewYork or na(newYorkPV) or na(newYorkVol)
    newYorkPV := hlc3 * volume
    newYorkVol := volume
else
    newYorkPV += hlc3 * volume
    newYorkVol += volume
float newYorkVwap = inNewYork and not na(newYorkVol) and newYorkVol > 0.0 ? newYorkPV / newYorkVol : na

float dailyVwap = ta.vwap(hlc3, barstate.isfirst or newDay)
float weeklyVwap = ta.vwap(hlc3, barstate.isfirst or newWeek)
float monthlyVwap = ta.vwap(hlc3, barstate.isfirst or newMonth)
float activeSessionVwap = inNewYork ? newYorkVwap : inLondon ? londonVwap : inAsia ? asiaVwap : na
float valueRef = switch valueReference
    "Active Session" => activeSessionVwap
    "Weekly" => weeklyVwap
    "Monthly" => monthlyVwap
    => dailyVwap
bool valueReset = switch valueReference
    "Active Session" => newAsia or newLondon or newNewYork
    "Weekly" => newWeek
    "Monthly" => newMonth
    => newDay
float vwapDistanceAtr = not na(valueRef) and not na(atr) and atr > 0.0 ? (close - valueRef) / atr : na
float p02Signed = not na(vwapDistanceAtr) ? f_clamp(vwapDistanceAtr / fullVwapDistanceAtr * 100.0, -100.0, 100.0) : na

//------------------------------------------------------------------------------
// P03 developing profile
//------------------------------------------------------------------------------
var array<float> profilePrices = array.new_float()
var array<float> profileHighs = array.new_float()
var array<float> profileLows = array.new_float()
var array<float> profileVolumes = array.new_float()
var array<float> bins = array.new_float()
var array<box> histBoxes = array.new_box()

if barstate.isfirst
    for i = 0 to binCount - 1
        array.push(bins, 0.0)
        box hb = box.new(bar_index, close, bar_index, close, xloc=xloc.bar_index, border_width=0, bgcolor=color.new(color.gray, 100))
        array.push(histBoxes, hb)

float profileHigh = na
float profileLow = na
float pocPrice = na
float vahPrice = na
float valPrice = na
float totalProfileVolume = 0.0
float valueAreaVolume = 0.0
float binSize = na
float maxBinVolume = na
int pocIndex = na
int vaLowIndex = na
int vaHighIndex = na
var float completedPoc = na
var float completedVah = na
var float completedVal = na

if profileReset and not barstate.isfirst
    completedPoc := pocPrice[1]
    completedVah := vahPrice[1]
    completedVal := valPrice[1]

if profileReset
    array.clear(profilePrices)
    array.clear(profileHighs)
    array.clear(profileLows)
    array.clear(profileVolumes)

if profileActive and not na(volume)
    array.push(profilePrices, allocationSource)
    array.push(profileHighs, high)
    array.push(profileLows, low)
    array.push(profileVolumes, volume)
    if array.size(profilePrices) > maxProfileBars
        array.shift(profilePrices)
        array.shift(profileHighs)
        array.shift(profileLows)
        array.shift(profileVolumes)

int storedProfileBars = array.size(profilePrices)
if storedProfileBars > 0
    profileHigh := array.max(profileHighs)
    profileLow := array.min(profileLows)
    float profileRange = profileHigh - profileLow
    binSize := math.max(profileRange > 0.0 ? profileRange / binCount : syminfo.mintick, syminfo.mintick)
    for i = 0 to binCount - 1
        array.set(bins, i, 0.0)
    for i = 0 to storedProfileBars - 1
        float p = array.get(profilePrices, i)
        float v = array.get(profileVolumes, i)
        int idx = int(math.floor((p - profileLow) / binSize))
        idx := math.max(0, math.min(binCount - 1, idx))
        array.set(bins, idx, array.get(bins, idx) + v)
        totalProfileVolume += v
    maxBinVolume := -1.0
    pocIndex := 0
    for i = 0 to binCount - 1
        float binVol = array.get(bins, i)
        if binVol > maxBinVolume
            maxBinVolume := binVol
            pocIndex := i
    pocPrice := profileLow + (pocIndex + 0.5) * binSize
    float targetVolume = totalProfileVolume * valueAreaPct / 100.0
    vaLowIndex := pocIndex
    vaHighIndex := pocIndex
    valueAreaVolume := array.get(bins, pocIndex)
    int expansionSteps = 0
    while valueAreaVolume < targetVolume and expansionSteps < binCount
        bool canDown = vaLowIndex > 0
        bool canUp = vaHighIndex < binCount - 1
        if not canDown and not canUp
            break
        float downVol = canDown ? array.get(bins, vaLowIndex - 1) : -1.0
        float upVol = canUp ? array.get(bins, vaHighIndex + 1) : -1.0
        if canDown and canUp and downVol == upVol
            vaLowIndex -= 1
            vaHighIndex += 1
            valueAreaVolume += downVol + upVol
        else if canUp and (not canDown or upVol > downVol)
            vaHighIndex += 1
            valueAreaVolume += upVol
        else if canDown
            vaLowIndex -= 1
            valueAreaVolume += downVol
        expansionSteps += 1
    valPrice := profileLow + vaLowIndex * binSize
    vahPrice := profileLow + (vaHighIndex + 1) * binSize

bool profileReady = profileActive and not na(pocPrice) and not na(vahPrice) and not na(valPrice)
float pocDistanceAtr = profileReady and not na(atr) and atr > 0.0 ? (close - pocPrice) / atr : na
float p03Signed = not na(pocDistanceAtr) ? f_clamp(pocDistanceAtr / fullPocDistanceAtr * 100.0, -100.0, 100.0) : na

//------------------------------------------------------------------------------
// P04 compact auction/value evidence
//------------------------------------------------------------------------------
float insideValue = profileReady and close <= vahPrice and close >= valPrice ? 1.0 : 0.0
float outsideDirection = profileReady ? (close > vahPrice ? 1.0 : close < valPrice ? -1.0 : 0.0) : 0.0
float previousMid = not na(completedVah) and not na(completedVal) ? (completedVah + completedVal) * 0.5 : na
float currentMid = profileReady ? (vahPrice + valPrice) * 0.5 : na
float previousWidth = not na(completedVah) and not na(completedVal) ? completedVah - completedVal : na
float valueShift = not na(currentMid) and not na(previousMid) and not na(previousWidth) and previousWidth > 0.0 ? f_clamp((currentMid - previousMid) / previousWidth * 100.0, -100.0, 100.0) : 0.0
float p04Signed = profileReady ? f_clamp(outsideDirection * 60.0 + valueShift * 0.40 - insideValue * 0.0, -100.0, 100.0) : na

//------------------------------------------------------------------------------
// Candidate mechanics
//------------------------------------------------------------------------------
bool bullishDisplacement = close > open and not na(bodyAtr) and bodyAtr >= minDisplacementAtr
bool bearishDisplacement = close < open and not na(bodyAtr) and bodyAtr >= minDisplacementAtr
bool bullFvg = detectFvg and bar_index >= 2 and low > high[2]
bool bearFvg = detectFvg and bar_index >= 2 and high < low[2]
float bullFvgWidthAtr = bullFvg and not na(atr) and atr > 0.0 ? (low - high[2]) / atr : na
float bearFvgWidthAtr = bearFvg and not na(atr) and atr > 0.0 ? (low[2] - high) / atr : na
bullFvg := bullFvg and bullishDisplacement and not na(bullFvgWidthAtr) and bullFvgWidthAtr >= minFvgAtr and bullFvgWidthAtr <= maxZoneWidthAtr
bearFvg := bearFvg and bearishDisplacement and not na(bearFvgWidthAtr) and bearFvgWidthAtr >= minFvgAtr and bearFvgWidthAtr <= maxZoneWidthAtr

bool bullOb = detectOb and bar_index >= 1 and close[1] < open[1] and bullishDisplacement and close > high[1]
bool bearOb = detectOb and bar_index >= 1 and close[1] > open[1] and bearishDisplacement and close < low[1]
float bullObWidthAtr = bullOb and not na(atr) and atr > 0.0 ? (high[1] - low[1]) / atr : na
float bearObWidthAtr = bearOb and not na(atr) and atr > 0.0 ? (high[1] - low[1]) / atr : na
bullOb := bullOb and not na(bullObWidthAtr) and bullObWidthAtr <= maxZoneWidthAtr
bearOb := bearOb and not na(bearObWidthAtr) and bearObWidthAtr <= maxZoneWidthAtr

//------------------------------------------------------------------------------
// Zone storage
// status: 0 fresh, 1 partial, 2 fully mitigated, 3 invalidated, 4 expired
//------------------------------------------------------------------------------
var array<box> zoneBoxes = array.new_box()
var array<float> zoneTops = array.new_float()
var array<float> zoneBottoms = array.new_float()
var array<float> zoneBirthScores = array.new_float()
var array<float> zoneScores = array.new_float()
var array<float> zoneMechanics = array.new_float()
var array<float> zoneMitigation = array.new_float()
var array<int> zoneDirections = array.new_int()
var array<int> zoneBornBars = array.new_int()
var array<int> zoneStatuses = array.new_int()
var array<int> zoneRetests = array.new_int()
var array<int> zoneLastTouchBars = array.new_int()
var array<string> zoneTypes = array.new_string()

var array<float> pendingTops = array.new_float()
var array<float> pendingBottoms = array.new_float()
var array<float> pendingMechanics = array.new_float()
var array<int> pendingDirections = array.new_int()
var array<string> pendingTypes = array.new_string()

f_addZone(string zType, int zDir, float zTop, float zBottom, float mechanic, float score, int leftBar) =>
    bool qualified = score >= minQualificationScore
    bool displayZone = showCandidates and (not showOnlyQualified or qualified)
    box b = na
    if displayZone
        color base = zType == "FVG" ? (zDir == 1 ? color.teal : color.red) : zType == "OB" ? (zDir == 1 ? color.green : color.red) : zType == "IFVG" ? (zDir == 1 ? color.aqua : color.fuchsia) : (zDir == 1 ? color.lime : color.maroon)
        b := box.new(leftBar, zTop, bar_index, zBottom, xloc=xloc.bar_index, extend=extend.right, border_color=color.new(base, qualified ? 20 : 70), bgcolor=color.new(base, qualified ? 84 : 94))
        if showZoneText
            box.set_text(b, zType + (zDir == 1 ? " B " : " S ") + str.tostring(score, "#.0") + " F")
            box.set_text_color(b, color.white)
    array.push(zoneBoxes, b)
    array.push(zoneTops, zTop)
    array.push(zoneBottoms, zBottom)
    array.push(zoneBirthScores, score)
    array.push(zoneScores, score)
    array.push(zoneMechanics, mechanic)
    array.push(zoneMitigation, 0.0)
    array.push(zoneDirections, zDir)
    array.push(zoneBornBars, bar_index)
    array.push(zoneStatuses, 0)
    array.push(zoneRetests, 0)
    array.push(zoneLastTouchBars, -1)
    array.push(zoneTypes, zType)

//------------------------------------------------------------------------------
// Candidate creation
//------------------------------------------------------------------------------
if bullFvg
    float mechanic = f_mechanicQuality(bodyAtr, bullFvgWidthAtr)
    float score = f_zoneScore(mechanic, f_support(1, p01Signed), f_support(1, p02Signed), f_support(1, p03Signed), f_support(1, p04Signed))
    f_addZone("FVG", 1, low, high[2], mechanic, score, bar_index - 2)
if bearFvg
    float mechanic = f_mechanicQuality(bodyAtr, bearFvgWidthAtr)
    float score = f_zoneScore(mechanic, f_support(-1, p01Signed), f_support(-1, p02Signed), f_support(-1, p03Signed), f_support(-1, p04Signed))
    f_addZone("FVG", -1, low[2], high, mechanic, score, bar_index - 2)
if bullOb
    float mechanic = f_mechanicQuality(bodyAtr, bullObWidthAtr)
    float score = f_zoneScore(mechanic, f_support(1, p01Signed), f_support(1, p02Signed), f_support(1, p03Signed), f_support(1, p04Signed))
    f_addZone("OB", 1, high[1], low[1], mechanic, score, bar_index - 1)
if bearOb
    float mechanic = f_mechanicQuality(bodyAtr, bearObWidthAtr)
    float score = f_zoneScore(mechanic, f_support(-1, p01Signed), f_support(-1, p02Signed), f_support(-1, p03Signed), f_support(-1, p04Signed))
    f_addZone("OB", -1, high[1], low[1], mechanic, score, bar_index - 1)

//------------------------------------------------------------------------------
// Lifecycle refinement
//------------------------------------------------------------------------------
array.clear(pendingTops)
array.clear(pendingBottoms)
array.clear(pendingMechanics)
array.clear(pendingDirections)
array.clear(pendingTypes)

int trackedNow = array.size(zoneScores)
if trackedNow > 0
    for i = 0 to trackedNow - 1
        int status = array.get(zoneStatuses, i)
        if status < 2
            float zTop = array.get(zoneTops, i)
            float zBottom = array.get(zoneBottoms, i)
            float zWidth = math.max(zTop - zBottom, syminfo.mintick)
            float birthScore = array.get(zoneBirthScores, i)
            float mechanic = array.get(zoneMechanics, i)
            float priorMitigation = array.get(zoneMitigation, i)
            int zDir = array.get(zoneDirections, i)
            int born = array.get(zoneBornBars, i)
            int retests = array.get(zoneRetests, i)
            int lastTouchBar = array.get(zoneLastTouchBars, i)
            string zType = array.get(zoneTypes, i)
            box b = array.get(zoneBoxes, i)

            bool invalid = (zDir == 1 and close < zBottom) or (zDir == -1 and close > zTop)
            bool expired = bar_index - born > maxZoneAgeBars
            float probe = mitigationBasis == "Close" ? close : zDir == 1 ? low : high
            bool touched = zDir == 1 ? probe <= zTop and probe >= zBottom : probe >= zBottom and probe <= zTop
            float penetration = priorMitigation
            if touched
                float currentPen = zDir == 1 ? (zTop - probe) / zWidth : (probe - zBottom) / zWidth
                penetration := math.max(priorMitigation, f_clamp(currentPen, 0.0, 1.0))

            bool newRetest = touched and bar_index > born and lastTouchBar != bar_index - 1
            if newRetest
                retests += 1
                array.set(zoneRetests, i, retests)
            if touched
                array.set(zoneLastTouchBars, i, bar_index)

            float mitigationPctNow = penetration * 100.0
            array.set(zoneMitigation, i, penetration)

            int ageBars = bar_index - born
            float agePenalty = freshnessDecayPer100Bars * ageBars / 100.0
            float mitigationPenalty = mitigationPenaltyMax * penetration
            float currentScore = f_clamp(birthScore - agePenalty - mitigationPenalty - retestPenalty * retests, 0.0, 100.0)
            array.set(zoneScores, i, currentScore)

            bool fullyMitigated = mitigationPctNow >= fullMitigationPct
            bool partiallyMitigated = mitigationPctNow >= partialMitigationPct and not fullyMitigated

            if invalid
                array.set(zoneStatuses, i, 3)
                if not na(b)
                    box.set_extend(b, extend.none)
                    box.set_right(b, bar_index)
                    if removeInvalidated
                        box.delete(b)
                        array.set(zoneBoxes, i, na)
                    else
                        box.set_bgcolor(b, color.new(color.gray, 94))
                        box.set_border_color(b, color.new(color.gray, 80))
                bool makeIfvg = createIfvg and zType == "FVG"
                bool makeBreaker = createBreaker and zType == "OB"
                if makeIfvg or makeBreaker
                    array.push(pendingTops, zTop)
                    array.push(pendingBottoms, zBottom)
                    array.push(pendingMechanics, f_clamp(mechanic * inversionMechanicFactor, 0.0, 100.0))
                    array.push(pendingDirections, -zDir)
                    array.push(pendingTypes, makeIfvg ? "IFVG" : "BRK")

            else if expired
                array.set(zoneStatuses, i, 4)
                if not na(b)
                    box.set_extend(b, extend.none)
                    box.set_right(b, bar_index)
                    if removeExpired
                        box.delete(b)
                        array.set(zoneBoxes, i, na)
                    else
                        box.set_bgcolor(b, color.new(color.gray, 96))
                        box.set_border_color(b, color.new(color.gray, 85))

            else if fullyMitigated
                array.set(zoneStatuses, i, 2)
                if not na(b)
                    box.set_extend(b, extend.none)
                    box.set_right(b, bar_index)
                    if removeFullyMitigated
                        box.delete(b)
                        array.set(zoneBoxes, i, na)
                    else
                        box.set_bgcolor(b, color.new(color.gray, 90))
                        if showZoneText
                            box.set_text(b, zType + (zDir == 1 ? " B " : " S ") + str.tostring(currentScore, "#.0") + " M")

            else if partiallyMitigated
                array.set(zoneStatuses, i, 1)
                if not na(b)
                    color partialColor = zDir == 1 ? color.green : color.red
                    box.set_bgcolor(b, color.new(partialColor, 90))
                    if showZoneText
                        box.set_text(b, zType + (zDir == 1 ? " B " : " S ") + str.tostring(currentScore, "#.0") + " P" + str.tostring(mitigationPctNow, "#.0") + "% R" + str.tostring(retests))
            else
                array.set(zoneStatuses, i, 0)
                if not na(b) and showZoneText
                    box.set_text(b, zType + (zDir == 1 ? " B " : " S ") + str.tostring(currentScore, "#.0") + " F R" + str.tostring(retests))

// Add re-qualified IFVG / Breaker zones after scan.
int pendingCount = array.size(pendingTops)
if pendingCount > 0
    for j = 0 to pendingCount - 1
        float zTop = array.get(pendingTops, j)
        float zBottom = array.get(pendingBottoms, j)
        float mechanic = array.get(pendingMechanics, j)
        int zDir = array.get(pendingDirections, j)
        string zType = array.get(pendingTypes, j)
        float score = f_zoneScore(mechanic, f_support(zDir, p01Signed), f_support(zDir, p02Signed), f_support(zDir, p03Signed), f_support(zDir, p04Signed))
        if score >= minInversionScore
            f_addZone(zType, zDir, zTop, zBottom, mechanic, score, bar_index)

// Bound tracking arrays.
while array.size(zoneScores) > maxTrackedZones
    box oldBox = array.shift(zoneBoxes)
    if not na(oldBox)
        box.delete(oldBox)
    array.shift(zoneTops)
    array.shift(zoneBottoms)
    array.shift(zoneBirthScores)
    array.shift(zoneScores)
    array.shift(zoneMechanics)
    array.shift(zoneMitigation)
    array.shift(zoneDirections)
    array.shift(zoneBornBars)
    array.shift(zoneStatuses)
    array.shift(zoneRetests)
    array.shift(zoneLastTouchBars)
    array.shift(zoneTypes)

//------------------------------------------------------------------------------
// Histogram toggle — fixed reusable box pool
//------------------------------------------------------------------------------
if barstate.islast
    for i = 0 to binCount - 1
        box hb = array.get(histBoxes, i)
        if showHistogram and profileActive and storedProfileBars > 0 and not na(maxBinVolume) and maxBinVolume > 0.0 and not na(binSize)
            float vol = array.get(bins, i)
            float ratio = vol / maxBinVolume
            int widthBars = math.max(1, int(math.round(ratio * histogramMaxWidth)))
            int rightX = bar_index + histogramOffset + histogramMaxWidth
            int leftX = rightX - widthBars
            float bottomY = profileLow + i * binSize
            float topY = bottomY + binSize
            bool inValueArea = not na(vaLowIndex) and not na(vaHighIndex) and i >= vaLowIndex and i <= vaHighIndex
            bool isPocBin = not na(pocIndex) and i == pocIndex
            color fillColor = isPocBin ? color.new(color.orange, 15) : inValueArea ? color.new(color.blue, 55) : color.new(color.gray, 78)
            box.set_left(hb, leftX)
            box.set_right(hb, rightX)
            box.set_bottom(hb, bottomY)
            box.set_top(hb, topY)
            box.set_bgcolor(hb, fillColor)
            box.set_border_color(hb, color.new(fillColor, 100))
        else
            box.set_left(hb, bar_index)
            box.set_right(hb, bar_index)
            box.set_bottom(hb, close)
            box.set_top(hb, close)
            box.set_bgcolor(hb, color.new(color.gray, 100))
            box.set_border_color(hb, color.new(color.gray, 100))

//------------------------------------------------------------------------------
// Reset-aware context plots
//------------------------------------------------------------------------------
float vwapPlot = showVwap and not valueReset ? valueRef : na
float pocPlot = showValueLevels and profileActive and not profileReset ? pocPrice : na
float vahPlot = showValueLevels and profileActive and not profileReset ? vahPrice : na
float valPlot = showValueLevels and profileActive and not profileReset ? valPrice : na
plot(vwapPlot, "Primary VWAP", color=color.new(color.blue, 20), linewidth=2, style=plot.style_linebr)
plot(pocPlot, "Profile POC", color=color.orange, linewidth=2, style=plot.style_linebr)
plot(vahPlot, "Profile VAH", color=color.new(color.green, 20), linewidth=1, style=plot.style_linebr)
plot(valPlot, "Profile VAL", color=color.new(color.red, 20), linewidth=1, style=plot.style_linebr)

//------------------------------------------------------------------------------
// Diagnostics
//------------------------------------------------------------------------------
int freshZones = 0
int partialZones = 0
int mitigatedZones = 0
int invalidZones = 0
int expiredZones = 0
int ifvgZones = 0
int breakerZones = 0
float highestActiveScore = na
float highestActiveMitigation = na
int zoneCount = array.size(zoneScores)
if zoneCount > 0
    for i = 0 to zoneCount - 1
        int s = array.get(zoneStatuses, i)
        string t = array.get(zoneTypes, i)
        if s == 0
            freshZones += 1
        else if s == 1
            partialZones += 1
        else if s == 2
            mitigatedZones += 1
        else if s == 3
            invalidZones += 1
        else if s == 4
            expiredZones += 1
        if t == "IFVG" and s < 2
            ifvgZones += 1
        if t == "BRK" and s < 2
            breakerZones += 1
        if s < 2
            float zs = array.get(zoneScores, i)
            float zm = array.get(zoneMitigation, i) * 100.0
            highestActiveScore := na(highestActiveScore) ? zs : math.max(highestActiveScore, zs)
            highestActiveMitigation := na(highestActiveMitigation) ? zm : math.max(highestActiveMitigation, zm)

var table diag = table.new(position.top_right, 2, 20, border_width=1, frame_width=1, bgcolor=color.new(color.black, 15))
f_setRow(int row, string labelText, string valueText) =>
    table.cell(diag, 0, row, labelText, text_color=color.silver, bgcolor=color.new(color.black, 15), text_halign=text.align_left)
    table.cell(diag, 1, row, valueText, text_color=color.white, bgcolor=color.new(color.black, 15), text_halign=text.align_right)

if barstate.islast
    if showTable
        table.clear(diag, 0, 0, 1, 19)
        f_setRow(0, "PLUTUS", "P05.2 Zone Lifecycle")
        f_setRow(1, "Fresh", str.tostring(freshZones))
        f_setRow(2, "Partial", str.tostring(partialZones))
        f_setRow(3, "Mitigated", str.tostring(mitigatedZones))
        f_setRow(4, "Invalidated", str.tostring(invalidZones))
        f_setRow(5, "Expired", str.tostring(expiredZones))
        f_setRow(6, "Active IFVG", str.tostring(ifvgZones))
        f_setRow(7, "Active Breakers", str.tostring(breakerZones))
        f_setRow(8, "Highest Active Score", not na(highestActiveScore) ? str.tostring(highestActiveScore, "#.1") : "N/A")
        f_setRow(9, "Max Active Mitigation", not na(highestActiveMitigation) ? str.tostring(highestActiveMitigation, "#.0") + "%" : "N/A")
        f_setRow(10, "Mitigation Basis", mitigationBasis)
        f_setRow(11, "Partial Threshold", str.tostring(partialMitigationPct, "#.0") + "%")
        f_setRow(12, "Full Threshold", str.tostring(fullMitigationPct, "#.0") + "%")
        f_setRow(13, "P01", not na(p01Signed) ? str.tostring(p01Signed, "#.0") : "N/A")
        f_setRow(14, "P02", not na(p02Signed) ? str.tostring(p02Signed, "#.0") : "N/A")
        f_setRow(15, "P03", not na(p03Signed) ? str.tostring(p03Signed, "#.0") : "N/A")
        f_setRow(16, "P04", not na(p04Signed) ? str.tostring(p04Signed, "#.0") : "N/A")
        f_setRow(17, "Profile Scope", profileScope)
        f_setRow(18, "Histogram", showHistogram ? "ON" : "OFF")
        f_setRow(19, "Tracked Zones", str.tostring(zoneCount))
    else
        table.clear(diag, 0, 0, 1, 19)
