            bool inValue=not na(vaLowIndex) and not na(vaHighIndex) and i>=vaLowIndex and i<=vaHighIndex
            color hc=showPocHighlight and i==pocIndex?color.new(cPoc,35):showValueAreaHighlight and inValue?color.new(color.blue,78):color.new(color.gray,88)
            box.set_lefttop(hb,leftX,top)
