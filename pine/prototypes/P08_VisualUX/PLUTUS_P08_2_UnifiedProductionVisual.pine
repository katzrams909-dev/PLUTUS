//@version=6
indicator("PLUTUS P08.2 — Unified Production Visual", shorttitle="PLUTUS P08.2", overlay=true, max_boxes_count=500, max_lines_count=260, max_labels_count=260)

// PLUTUS P08.2 — final P08 production-facing visual layer.
// Carries forward P08.1 profile/zone/divergence behavior. No trade signals.

//------------------------------------------------------------------------------
// Display / UX
//------------------------------------------------------------------------------
groupDisplay = "Display / UX"
displayPreset = input.string("Balanced", "Display Preset", options=["Minimal", "Balanced", "Full", "Diagnostic"], group=groupDisplay)
showStatusPanelInput = input.bool(true, "Status Panel", group=groupDisplay)
showVwapInput = input.bool(true, "VWAP", group=groupDisplay)
showValueLevelsInput = input.bool(true, "POC / VAH / VAL", group=groupDisplay)
showHistogramInput = input.bool(false, "Volume Profile Histogram", group=groupDisplay)
showZonesInput = input.bool(true, "Institutional Zones", group=groupDisplay)
showDivergenceInput = input.bool(true, "Divergence", group=groupDisplay)
showTransitionsInput = input.bool(true, "Material Transitions", group=groupDisplay)
showBiasBackgroundInput = input.bool(false, "Bias Background", group=groupDisplay)
showDiagnosticsInput = input.bool(false, "Diagnostics", group=groupDisplay)
panelPosition = input.string("Top Right", "Status Panel Position", options=["Top Right", "Top Left", "Bottom Right", "Bottom Left"], group=groupDisplay)
compactPanel = input.bool(true, "Compact Status Panel", group=groupDisplay)

bool presetMinimal = displayPreset == "Minimal"
bool presetBalanced = displayPreset == "Balanced"
bool presetFull = displayPreset == "Full"
bool presetDiagnostic = displayPreset == "Diagnostic"
bool showStatusPanel = showStatusPanelInput
bool showVwap = showVwapInput and not presetMinimal
bool showValueLevels = showValueLevelsInput and not presetMinimal
bool showHistogram = showHistogramInput and (presetFull or presetDiagnostic)
bool showZones = showZonesInput and not presetMinimal
bool showDivergence = showDivergenceInput and (presetFull or presetDiagnostic)
bool showTransitions = showTransitionsInput and not presetMinimal
bool showBiasBackground = showBiasBackgroundInput and (presetFull or presetDiagnostic)
bool showDiagnostics = showDiagnosticsInput or presetDiagnostic

//------------------------------------------------------------------------------
// Timing / context
//------------------------------------------------------------------------------
groupTiming = "Timing / Context"
timezoneInput = input.string("Exchange", "Session Timezone", options=["Exchange", "UTC-2", "UTC-1", "UTC+0", "UTC+1", "UTC+2", "America/New_York", "Europe/London", "Asia/Tokyo"], group=groupTiming)
string sessionTz = timezoneInput == "Exchange" ? syminfo.timezone : timezoneInput
profileScope = input.string("Day", "Profile Scope", options=["Asia", "London", "New York", "Day"], group=groupTiming)
valueReference = input.string("Daily", "VWAP Reference", options=["Active Session", "Daily", "Weekly", "Monthly"], group=groupTiming)

//------------------------------------------------------------------------------
// Volume profile
//------------------------------------------------------------------------------
groupProfile = "Volume Profile"
profileRows = input.int(80, "Profile Rows", minval=16, maxval=160, step=8, group=groupProfile)
maxProfileBars = input.int(300, "Maximum Bars Per Profile", minval=25, maxval=1000, group=groupProfile)
valueAreaPct = input.float(70.0, "Value Area %", minval=50.0, maxval=99.0, step=1.0, group=groupProfile)
profileAllocation = input.string("Range Overlap", "Volume Allocation", options=["Range Overlap", "HLC3 Point"], group=groupProfile)
histogramWidth = input.int(24, "Histogram Maximum Width", minval=5, maxval=100, group=groupProfile)
histogramOffset = input.int(4, "Histogram Right Offset", minval=1, maxval=50, group=groupProfile)
showValueAreaHighlight = input.bool(true, "Highlight Value Area", group=groupProfile)
showPocHighlight = input.bool(true, "Highlight POC Bin", group=groupProfile)
showNodes = input.bool(false, "Show Strongest HVN / LVN", group=groupProfile)
smoothingRadius = input.int(1, "HVN/LVN Smoothing Radius", minval=0, maxval=4, group=groupProfile)
hvnThreshold = input.float(1.35, "HVN Min Volume / Mean", minval=1.0, step=0.05, group=groupProfile)
lvnThreshold = input.float(0.65, "LVN Max Volume / Mean", minval=0.05, maxval=1.0, step=0.05, group=groupProfile)
lineWidth = input.int(2, "POC / VA Line Width", minval=1, maxval=4, group=groupProfile)

//------------------------------------------------------------------------------
// Institutional zones
//------------------------------------------------------------------------------
groupDetection = "Institutional Zone Detection"
atrLen = input.int(14, "ATR Length", minval=1, group=groupDetection)
volumeLen = input.int(20, "Volume Baseline Length", minval=2, group=groupDetection)
structureLookback = input.int(5, "OB Structure Break Lookback", minval=2, maxval=30, group=groupDetection)
minDisplacementAtr = input.float(0.50, "Minimum Displacement Body / ATR", minval=0.05, step=0.05, group=groupDetection)
minDisplacementEfficiency = input.float(0.55, "Minimum Displacement Body / Range", minval=0.10, maxval=1.0, step=0.05, group=groupDetection)
fullDisplacementAtr = input.float(1.0, "Full Mechanical Displacement / ATR", minval=0.10, step=0.10, group=groupDetection)
minFvgAtr = input.float(0.10, "Minimum FVG Width / ATR", minval=0.0, step=0.01, group=groupDetection)
minFvgTicks = input.int(3, "Minimum FVG Width (Ticks)", minval=1, maxval=100, group=groupDetection)
maxZoneWidthAtr = input.float(1.50, "Maximum Zone Width / ATR", minval=0.25, step=0.25, group=groupDetection)
requireDisplacementFvg = input.bool(true, "Reject Opening-Gap FVG Artifacts", group=groupDetection)
suppressNestedFvg = input.bool(true, "Suppress Nested / Overlapping FVGs", group=groupDetection)
fvgFamilyOverlapPct = input.float(50.0, "FVG Family Overlap Threshold %", minval=10.0, maxval=100.0, step=5.0, group=groupDetection)
obRangeMode = input.string("Body", "Order Block Range", options=["Body", "Full Candle"], group=groupDetection)
detectFvg = input.bool(true, "Detect FVG Candidates", group=groupDetection)
detectOb = input.bool(true, "Detect Order Block Candidates", group=groupDetection)
duplicateOverlapPct = input.float(70.0, "Duplicate Overlap Threshold %", minval=25.0, maxval=100.0, step=5.0, group=groupDetection)
minZoneSeparationAtr = input.float(0.10, "Minimum Same-Type Zone Separation / ATR", minval=0.0, step=0.05, group=groupDetection)

groupQualification = "Institutional Zone Qualification"
minQualificationScore = input.float(60.0, "Institutional Qualification Score", minval=0.0, maxval=100.0, step=5.0, group=groupQualification)
fullRvol = input.float(2.0, "Full Participation RVOL", minval=1.0, step=0.1, group=groupQualification)
fullVwapDistanceAtr = input.float(1.0, "Full VWAP Distance / ATR", minval=0.10, step=0.10, group=groupQualification)
fullPocDistanceAtr = input.float(1.0, "Full POC Distance / ATR", minval=0.10, step=0.10, group=groupQualification)

groupLifecycle = "Institutional Zone Lifecycle"
mitigationBasis = input.string("Wick", "Mitigation Basis", options=["Wick", "Close"], group=groupLifecycle)
partialMitigationPct = input.float(25.0, "Partial Mitigation Threshold %", minval=1.0, maxval=95.0, step=5.0, group=groupLifecycle)
fullMitigationPct = input.float(95.0, "Full Mitigation Threshold %", minval=5.0, maxval=100.0, step=5.0, group=groupLifecycle)
mitigationPenaltyMax = input.float(25.0, "Maximum Mitigation Score Penalty", minval=0.0, maxval=75.0, step=5.0, group=groupLifecycle)
retestPenalty = input.float(5.0, "Penalty Per Retest", minval=0.0, maxval=25.0, step=1.0, group=groupLifecycle)
freshnessDecayPer100Bars = input.float(10.0, "Freshness Decay Per 100 Bars", minval=0.0, maxval=50.0, step=1.0, group=groupLifecycle)
maxZoneAgeBars = input.int(250, "Maximum Zone Age (Bars)", minval=10, maxval=2000, group=groupLifecycle)
maxTrackedZones = input.int(30, "Maximum Tracked Zones", minval=4, maxval=80, group=groupLifecycle)
removeFullyMitigated = input.bool(true, "Remove Fully Mitigated Zones", group=groupLifecycle)
removeInvalidated = input.bool(true, "Remove Invalidated Zones", group=groupLifecycle)
removeExpired = input.bool(true, "Remove Expired Zones", group=groupLifecycle)
showOnlyQualified = input.bool(true, "Show Only Qualified Zones", group=groupLifecycle)
showZoneText = input.bool(true, "Show Type / Score / Lifecycle", group=groupLifecycle)
zoneOpacityFresh = input.int(84, "Fresh Zone Opacity", minval=50, maxval=98, group=groupLifecycle)
zoneOpacityStale = input.int(94, "Stale Zone Opacity", minval=70, maxval=99, group=groupLifecycle)

groupInversion = "Inversion / Breakers"
createIfvg = input.bool(true, "Create IFVG From Invalidated FVG", group=groupInversion)
createBreaker = input.bool(true, "Create Breaker From Invalidated OB", group=groupInversion)
inversionMechanicFactor = input.float(0.70, "Inherited Mechanical Quality", minval=0.25, maxval=1.0, step=0.05, group=groupInversion)
minInversionBreakAtr = input.float(0.10, "Minimum Close Through Zone / ATR", minval=0.0, step=0.05, group=groupInversion)
inversionConfirmBars = input.int(2, "Inversion Confirmation Window", minval=1, maxval=5, group=groupInversion)
minInversionScore = input.float(60.0, "Minimum Inversion Qualification", minval=0.0, maxval=100.0, step=5.0, group=groupInversion)

//------------------------------------------------------------------------------
// Divergence
//------------------------------------------------------------------------------
groupDivergence = "Divergence"
leftBars = input.int(3, "Pivot Left Bars", minval=1, maxval=20, group=groupDivergence)
rightBars = input.int(3, "Pivot Right Bars", minval=1, maxval=20, group=groupDivergence)
oscillator = input.string("RSI", "Oscillator", options=["RSI", "MACD Histogram"], group=groupDivergence)
rsiLen = input.int(14, "RSI Length", minval=2, group=groupDivergence)
macdFast = input.int(12, "MACD Fast", minval=1, group=groupDivergence)
macdSlow = input.int(26, "MACD Slow", minval=2, group=groupDivergence)
macdSignal = input.int(9, "MACD Signal", minval=1, group=groupDivergence)
minPivotGapBars = input.int(5, "Minimum Pivot Separation", minval=1, maxval=100, group=groupDivergence)
maxPivotGapBars = input.int(120, "Maximum Pivot Separation", minval=5, maxval=1000, group=groupDivergence)
showRegular = input.bool(true, "Regular Divergence", group=groupDivergence)
showHidden = input.bool(true, "Hidden Divergence", group=groupDivergence)
eventExpiryBars = input.int(30, "Divergence Event Expiry", minval=1, maxval=500, group=groupDivergence)
maxDivergenceObjects = input.int(24, "Maximum Divergence Events", minval=4, maxval=60, group=groupDivergence)

//------------------------------------------------------------------------------
// Confluence
//------------------------------------------------------------------------------
groupWeights = "Confluence"
wP01 = input.float(20.0, "P01 Participation Weight", minval=0, maxval=100, step=1, group=groupWeights)
wP02 = input.float(15.0, "P02 Fair Value Weight", minval=0, maxval=100, step=1, group=groupWeights)
wP03 = input.float(15.0, "P03 Profile Weight", minval=0, maxval=100, step=1, group=groupWeights)
wP04 = input.float(20.0, "P04 Value Analysis Weight", minval=0, maxval=100, step=1, group=groupWeights)
wP05 = input.float(20.0, "P05 Institutional Zones Weight", minval=0, maxval=100, step=1, group=groupWeights)
wP06 = input.float(10.0, "P06 Divergence Weight", minval=0, maxval=100, step=1, group=groupWeights)
activeThreshold = input.float(15.0, "Engine Active Threshold", minval=0, maxval=100, step=5, group=groupWeights)
reliableThreshold = input.float(35.0, "Reliable Evidence Threshold", minval=0, maxval=100, step=5, group=groupWeights)
minActiveEngines = input.int(3, "Minimum Active Engines", minval=1, maxval=6, group=groupWeights)
minReliableEngines = input.int(2, "Minimum Reliable Engines", minval=1, maxval=6, group=groupWeights)
strongThreshold = input.float(60.0, "Strong Confluence Threshold", minval=20, maxval=100, step=5, group=groupWeights)
hysteresisEnter = input.float(20.0, "Directional Entry Threshold", minval=0, maxval=100, step=5, group=groupWeights)
hysteresisExit = input.float(10.0, "Directional Exit Threshold", minval=0, maxval=100, step=5, group=groupWeights)
transitionMinDelta = input.float(20.0, "Material Transition Score Delta", minval=1, maxval=100, step=1, group=groupWeights)
maxTransitionLabels = input.int(14, "Maximum Transition Labels", minval=3, maxval=60, group=groupWeights)
transitionCooldown = input.int(5, "Transition Label Cooldown Bars", minval=0, maxval=50, group=groupWeights)

//------------------------------------------------------------------------------
// Helpers / palette
//------------------------------------------------------------------------------
f_clamp(float x, float lo, float hi) => math.max(lo, math.min(hi, x))
f_rel(float score) =>
    float a = math.abs(score)
    a < activeThreshold ? 0.0 : f_clamp((a-activeThreshold)/math.max(100.0-activeThreshold,1.0),0.0,1.0)
f_effWeight(float base, float reliability, bool available) => available ? base*(0.50+reliability*0.50) : 0.0
f_widthQuality(float widthAtr) =>
    float q = widthAtr <= 0.75 ? 100.0 : 100.0*(1.0-(widthAtr-0.75)/math.max(maxZoneWidthAtr-0.75,0.01))
    f_clamp(q,0.0,100.0)
f_mechanicQuality(float dispAtr,float efficiency,float widthAtr) =>
    float d = f_clamp(dispAtr/math.max(fullDisplacementAtr,0.01)*100.0,0.0,100.0)
    float e = f_clamp(efficiency*100.0,0.0,100.0)
    f_clamp(d*0.50+e*0.20+f_widthQuality(widthAtr)*0.30,0.0,100.0)
f_overlapPct(float topA,float botA,float topB,float botB) =>
    float overlap = math.max(0.0,math.min(topA,topB)-math.max(botA,botB))
    float minWidth = math.max(math.min(topA-botA,topB-botB),syminfo.mintick)
    overlap/minWidth*100.0
f_stateColor(string s) =>
    s=="CONFLUENCE_STRONGLY_BULLISH"?color.lime:s=="CONFLUENCE_BULLISH"?color.green:s=="CONFLUENCE_STRONGLY_BEARISH"?color.red:s=="CONFLUENCE_BEARISH"?color.maroon:s=="CONFLUENCE_LOW_CONFIDENCE"?color.yellow:color.gray

color cBull=color.lime
color cBear=color.red
color cVwap=color.aqua
color cPoc=color.orange
color cVa=color.silver
color cHvn=color.fuchsia
color cLvn=color.gray

//------------------------------------------------------------------------------
// Sessions / resets
//------------------------------------------------------------------------------
string asiaSession="0000-0800:1234567"
string londonSession="0800-1630:1234567"
string newYorkSession="1330-2000:1234567"
bool inAsia=not na(time(timeframe.period,asiaSession,sessionTz))
bool inLondon=not na(time(timeframe.period,londonSession,sessionTz))
bool inNewYork=not na(time(timeframe.period,newYorkSession,sessionTz))
bool newAsia=inAsia and not inAsia[1]
bool newLondon=inLondon and not inLondon[1]
bool newNewYork=inNewYork and not inNewYork[1]
int localDay=dayofmonth(time,sessionTz)
int localWeek=weekofyear(time,sessionTz)
int localMonth=month(time,sessionTz)
bool newDay=ta.change(localDay)!=0
bool newWeek=ta.change(localWeek)!=0
bool newMonth=ta.change(localMonth)!=0
bool profileActive=profileScope=="Asia"?inAsia:profileScope=="London"?inLondon:profileScope=="New York"?inNewYork:true
bool profileReset=profileScope=="Asia"?newAsia:profileScope=="London"?newLondon:profileScope=="New York"?newNewYork:barstate.isfirst or newDay
bool profileVisualActive=profileScope=="Day"?true:profileActive

//------------------------------------------------------------------------------
// P01 participation
//------------------------------------------------------------------------------
float atr=ta.atr(atrLen)
float candleRange=math.max(high-low,syminfo.mintick)
float body=math.abs(close-open)
float bodyEff=body/candleRange
float bodyAtr=not na(atr) and atr>0?body/atr:0.0
float volBase=ta.sma(volume,volumeLen)
float rvol=not na(volume) and not na(volBase) and volBase>0?volume/volBase:na
float p01Magnitude=not na(rvol)?f_clamp((rvol-0.75)/math.max(fullRvol-0.75,0.01)*100.0,0.0,100.0):0.0
int barDir=close>open?1:close<open?-1:0
float p01=barDir*f_clamp(p01Magnitude*0.65+bodyEff*35.0,0.0,100.0)
bool a01=not na(rvol)

//------------------------------------------------------------------------------
// P02 VWAP — reset-safe / finite
//------------------------------------------------------------------------------
var float asiaPV=na
var float asiaVol=na
if not inAsia
    asiaPV:=na
    asiaVol:=na
else if newAsia or na(asiaPV)
    asiaPV:=hlc3*volume
    asiaVol:=volume
else
    asiaPV+=hlc3*volume
    asiaVol+=volume
float asiaVwap=inAsia and asiaVol>0?asiaPV/asiaVol:na
var float londonPV=na
var float londonVol=na
if not inLondon
    londonPV:=na
    londonVol:=na
else if newLondon or na(londonPV)
    londonPV:=hlc3*volume
    londonVol:=volume
else
    londonPV+=hlc3*volume
    londonVol+=volume
float londonVwap=inLondon and londonVol>0?londonPV/londonVol:na
var float nyPV=na
var float nyVol=na
if not inNewYork
    nyPV:=na
    nyVol:=na
else if newNewYork or na(nyPV)
    nyPV:=hlc3*volume
    nyVol:=volume
else
    nyPV+=hlc3*volume
    nyVol+=volume
float nyVwap=inNewYork and nyVol>0?nyPV/nyVol:na
float dailyVwap=ta.vwap(hlc3,barstate.isfirst or newDay)
float weeklyVwap=ta.vwap(hlc3,barstate.isfirst or newWeek)
float monthlyVwap=ta.vwap(hlc3,barstate.isfirst or newMonth)
float activeSessionVwap=inNewYork?nyVwap:inLondon?londonVwap:inAsia?asiaVwap:na
float valueRef=valueReference=="Active Session"?activeSessionVwap:valueReference=="Weekly"?weeklyVwap:valueReference=="Monthly"?monthlyVwap:dailyVwap
bool valueReset=valueReference=="Active Session"?(newAsia or newLondon or newNewYork):valueReference=="Weekly"?newWeek:valueReference=="Monthly"?newMonth:newDay
float p02=not na(valueRef) and not na(atr) and atr>0?f_clamp((close-valueRef)/atr/fullVwapDistanceAtr*100.0,-100.0,100.0):0.0
bool a02=not na(valueRef) and not na(atr)
plot(showVwap and not valueReset?valueRef:na,"Primary VWAP",color=cVwap,linewidth=presetMinimal?1:2,style=plot.style_linebr)

//------------------------------------------------------------------------------
// P03/P04 shared volume-profile grid
//------------------------------------------------------------------------------
var array<float> profileHighs=array.new_float()
var array<float> profileLows=array.new_float()
var array<float> profileVolumes=array.new_float()
var array<float> bins=array.new_float()
var array<float> smoothBins=array.new_float()
var array<box> histBoxes=array.new_box()
if barstate.isfirst
    for i=0 to profileRows-1
        array.push(bins,0.0)
        array.push(smoothBins,0.0)
        array.push(histBoxes,box.new(bar_index,close,bar_index,close,xloc=xloc.bar_index,border_width=0,bgcolor=color.new(color.gray,100)))
if profileReset
    array.clear(profileHighs)
    array.clear(profileLows)
    array.clear(profileVolumes)
if profileActive and not na(volume)
    array.push(profileHighs,high)
    array.push(profileLows,low)
    array.push(profileVolumes,volume)
    if array.size(profileVolumes)>maxProfileBars
        array.shift(profileHighs),array.shift(profileLows),array.shift(profileVolumes)
int storedBars=array.size(profileVolumes)
float profileHigh=na
float profileLow=na
float rowSize=na
float pocPrice=na
float vahPrice=na
float valPrice=na
float strongestHvnPrice=na
float strongestLvnPrice=na
float totalProfileVolume=0.0
int pocIndex=na
int vaLowIndex=na
int vaHighIndex=na
if storedBars>0
    profileHigh:=array.max(profileHighs)
    profileLow:=array.min(profileLows)
    rowSize:=math.max((profileHigh-profileLow)>0?(profileHigh-profileLow)/profileRows:syminfo.mintick,syminfo.mintick)
    for i=0 to profileRows-1
        array.set(bins,i,0.0)
        array.set(smoothBins,i,0.0)
    for j=0 to storedBars-1
        float bh=array.get(profileHighs,j)
        float bl=array.get(profileLows,j)
        float bv=array.get(profileVolumes,j)
        if profileAllocation=="HLC3 Point"
            float px=(bh+bl+(bh+bl)*0.5)/3.0
            int idx=int(math.floor((px-profileLow)/rowSize))
            idx:=math.max(0,math.min(profileRows-1,idx))
            array.set(bins,idx,array.get(bins,idx)+bv)
            totalProfileVolume+=bv
        else
            float br=math.max(bh-bl,syminfo.mintick)
            int firstRow=math.max(0,math.min(profileRows-1,int(math.floor((bl-profileLow)/rowSize))))
            int lastRow=math.max(0,math.min(profileRows-1,int(math.floor((bh-profileLow)/rowSize))))
            for r=firstRow to lastRow
                float rb=profileLow+r*rowSize
                float rt=rb+rowSize
                float overlap=math.max(0.0,math.min(bh,rt)-math.max(bl,rb))
                if overlap>0
                    float allocated=bv*overlap/br
                    array.set(bins,r,array.get(bins,r)+allocated)
                    totalProfileVolume+=allocated
    float maxBinVolume=-1.0
    pocIndex:=0
    for i=0 to profileRows-1
        float bv=array.get(bins,i)
        if bv>maxBinVolume
            maxBinVolume:=bv
            pocIndex:=i
    pocPrice:=profileLow+(pocIndex+0.5)*rowSize
    float target=totalProfileVolume*valueAreaPct/100.0
    vaLowIndex:=pocIndex
    vaHighIndex:=pocIndex
    float vaVolume=array.get(bins,pocIndex)
    int steps=0
    while vaVolume<target and steps<profileRows
        bool canDown=vaLowIndex>0
        bool canUp=vaHighIndex<profileRows-1
        if not canDown and not canUp
            break
        float downVol=canDown?array.get(bins,vaLowIndex-1):-1.0
        float upVol=canUp?array.get(bins,vaHighIndex+1):-1.0
        if canDown and canUp and downVol==upVol
            vaLowIndex-=1
            vaHighIndex+=1
            vaVolume+=downVol+upVol
        else if canUp and (not canDown or upVol>downVol)
            vaHighIndex+=1
            vaVolume+=upVol
        else
            vaLowIndex-=1
            vaVolume+=downVol
        steps+=1
    valPrice:=profileLow+vaLowIndex*rowSize
    vahPrice:=profileLow+(vaHighIndex+1)*rowSize
    for i=0 to profileRows-1
        float sumVol=0.0
        int cnt=0
        int l=math.max(0,i-smoothingRadius)
        int rr=math.min(profileRows-1,i+smoothingRadius)
        for k=l to rr
            sumVol+=array.get(bins,k)
            cnt+=1
        array.set(smoothBins,i,cnt>0?sumVol/cnt:0.0)
    float meanSmooth=0.0
    for i=0 to profileRows-1
        meanSmooth+=array.get(smoothBins,i)
    meanSmooth:=meanSmooth/profileRows
    float bestHvn=na
    float bestLvn=na
    int bestHvnIdx=na
    int bestLvnIdx=na
    if meanSmooth>0
        for i=1 to profileRows-2
            float cur=array.get(smoothBins,i)
            float prev=array.get(smoothBins,i-1)
            float nxt=array.get(smoothBins,i+1)
            float rel=cur/meanSmooth
            if cur>=prev and cur>=nxt and rel>=hvnThreshold and (na(bestHvn) or rel>bestHvn)
                bestHvn:=rel
                bestHvnIdx:=i
            if cur<=prev and cur<=nxt and rel<=lvnThreshold
                float strength=meanSmooth/math.max(cur,meanSmooth*0.01)
                if na(bestLvn) or strength>bestLvn
                    bestLvn:=strength
                    bestLvnIdx:=i
    strongestHvnPrice:=not na(bestHvnIdx)?profileLow+(bestHvnIdx+0.5)*rowSize:na
    strongestLvnPrice:=not na(bestLvnIdx)?profileLow+(bestLvnIdx+0.5)*rowSize:na
float p03=not na(pocPrice) and not na(atr) and atr>0?f_clamp((close-pocPrice)/atr*75.0,-100.0,100.0):0.0
bool a03=not na(pocPrice)
float vaMid=not na(vahPrice) and not na(valPrice)?(vahPrice+valPrice)*0.5:na
